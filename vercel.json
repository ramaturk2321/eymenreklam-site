{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/sunum",
      "destination": "/eymen-reklam-sunumu.pdf"
    },
    {
      "source": "/sunum/",
      "destination": "/eymen-reklam-sunumu.pdf"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/favicon.(svg|ico|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/eymen-reklam-sunumu.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Eymen-Reklam-Sunum.pdf\""
        }
      ]
    }
  ],
