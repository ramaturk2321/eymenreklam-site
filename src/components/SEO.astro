---
import { contact, company, hours } from '../lib/site-data';
import { sozluk, DIL_BILGISI, YAYINDAKI_DILLER, dilAlternatifleri } from '../i18n';
import type { Dil, SayfaKimligi } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  lang?: Dil;
  /** Verilirse hreflang alternatifleri basılır. Yalnızca TR'de yayınlanan
   *  sayfalarda (ürün, blog) verilmez. */
  kimlik?: SayfaKimligi;
}

const DEFAULT_OG_IMAGE = '/images/fabrika-og.jpg';
const { title, description, image = DEFAULT_OG_IMAGE, type = 'website', lang = 'tr', kimlik } = Astro.props;
const s = sozluk(lang);
const dilBilgi = DIL_BILGISI[lang];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// hreflang — her dil kendini de listeler (Google bunu bekler), x-default TR.
// Tek dil yayındayken hreflang basmanın anlamı yok.
const alternatifler = kimlik && YAYINDAKI_DILLER.length > 1 ? dilAlternatifleri(kimlik) : [];
const digerLocaleler = YAYINDAKI_DILLER.filter((d) => d !== lang).map((d) => DIL_BILGISI[d].ogLocale);
const imageURL = new URL(image, Astro.site);
// og:image boyutları yalnızca sabit 1200x630 varsayılan görsel için doğru
const isDefaultOgImage = image === DEFAULT_OG_IMAGE;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  name: company.name,
  legalName: company.fullName,
  alternateName: company.alternateName,
  description: s.seo.isletmeAciklamasi,
  url: company.siteUrl,
  logo: new URL(company.logoPath, Astro.site).toString(),
  // Ana telefon = müşteri hattı 0545 (Google İşletme Profili'nde de birincil numara bu)
  telephone: contact.mobileHref.replace('tel:', ''),
  email: contact.email,
  foundingDate: String(company.founded),
  address: contact.postal,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: contact.geo.latitude,
    longitude: contact.geo.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: hours.schemaDays,
      opens: hours.open,
      closes: hours.close,
    },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    // İkincil: ofis sabit hattı
    telephone: contact.phoneHref.replace('tel:', ''),
    contactType: 'customer service',
    availableLanguage: YAYINDAKI_DILLER.map((d) => DIL_BILGISI[d].schemaDil),
  },
  image: imageURL.toString(),
  priceRange: '$$',
  areaServed: {
    '@type': 'City',
    name: 'İstanbul',
  },
  sameAs: [
    'https://www.instagram.com/eymenreklamltd/',
    'https://www.youtube.com/@eymenreklamltd',
    'https://www.linkedin.com/company/eymenreklamltd/',
    'https://www.facebook.com/eymenreklamltd/',
    'https://www.eymenreklam.com',
    'https://www.pendikuvbaski.com',
    'https://www.pendikbezbaski.com',
  ],
  inLanguage: dilBilgi.htmlLang,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.seo.katalogAdi,
    itemListElement: s.seo.hizmetListesi.map((ad) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: ad },
    })),
  },
};
---

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang — yalnızca çok dilli yayınlanan sayfalarda -->
{alternatifler.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site)} />
))}
{alternatifler.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternatifler[0].href, Astro.site)} />
)}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={`${title} | ${s.seo.siteAdi}`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{isDefaultOgImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
  </>
)}
<meta property="og:locale" content={dilBilgi.ogLocale} />
{alternatifler.length > 0 && digerLocaleler.map((l) => (
  <meta property="og:locale:alternate" content={l} />
))}
<meta property="og:site_name" content={s.seo.siteAdi} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | ${s.seo.siteAdi}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
