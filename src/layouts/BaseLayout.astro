---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SEO from '../components/SEO.astro';
import { company } from '../lib/site-data';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = `Eymen Reklam — Tabela İmalatı & UV Baskı Pendik İstanbul. ☎ (0216) 379 07 08 — ${company.experience} yıllık üretim tecrübesi.`, image } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="help" href="/llms.txt" type="text/plain" title="LLM Information" />
    <!-- Self-hosted Poppins — render-blocking Google Fonts kaldırıldı -->
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/poppins-400.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/poppins-500.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/poppins-600.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/poppins-700.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/poppins-800.woff2') format('woff2'); }
    </style>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BP7BT5C1X1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BP7BT5C1X1');
    </script>
    <title>{title} | Eymen Reklam</title>
    <SEO title={title} description={description} image={image} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-eymen-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold focus:shadow-lg">İçeriğe atla</a>
    <Header />
    <main id="icerik" tabindex="-1" class="flex-1 pt-20 lg:pt-[132px] outline-none">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import { inject, track } from '@vercel/analytics';
      inject();

      // Dönüşüm takibi — form success dallarından çağrılabilsin diye global yardımcı
      window.trackEvent = (name, props) => {
        try { track(name, props || {}); } catch (e) {}
      };

      // WhatsApp ve telefon tıklamalarını site genelinde yakala (event delegation)
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element ? e.target.closest('a') : null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        if (href.includes('wa.me')) {
          // Sosyal paylaşım linki (wa.me/?text=...) hariç → sadece bize yazan lead'ler
          if (!/wa\.me\/\?/.test(href)) {
            track('whatsapp_click', { path: location.pathname });
          }
        } else if (href.indexOf('tel:') === 0) {
          track('phone_click', { number: href.slice(4), path: location.pathname });
        }
      }, true);
    </script>
  </body>
</html>
