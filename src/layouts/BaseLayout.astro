---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SEO from '../components/SEO.astro';
import { company, contact } from '../lib/site-data';
import { sozluk, DIL_BILGISI } from '../i18n';
import type { Dil, YolAnahtari } from '../i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Sayfanın dili — EN/AR sayfaları bunu açıkça verir, TR sayfaları vermez. */
  lang?: Dil;
  /** hreflang ve dil değiştirici için sayfa anahtarı. Yalnızca TR'de yayınlanan
   *  sayfalarda (ürün, blog) verilmez; o zaman hreflang basılmaz. */
  sayfa?: YolAnahtari;
  /** Hizmet/proje detayında TR slug */
  slug?: string;
  tur?: 'hizmet' | 'proje';
}

const { title, description, image, lang = 'tr', sayfa, slug, tur } = Astro.props;
const s = sozluk(lang);
const dilBilgi = DIL_BILGISI[lang];
const aciklama = description ?? `${s.seo.varsayilanAciklama} ☎ ${contact.phone}`;
const kimlik = sayfa ? { anahtar: sayfa, slug, tur } : undefined;
---

<!doctype html>
<html lang={dilBilgi.htmlLang} dir={dilBilgi.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={aciklama} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="help" href="/llms.txt" type="text/plain" title="LLM Information" />
    <!-- Self-hosted Poppins — render-blocking Google Fonts kaldırıldı -->
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/poppins-400.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/poppins-500.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/poppins-600.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/poppins-700.woff2') format('woff2'); }
      @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/poppins-800.woff2') format('woff2'); }
    </style>
    <!-- Google Analytics 4 — gtag.js (191 KB) ana iş parçacığını kilitlediği için ilk etkileşimde
         veya load + 4 sn sonra yüklenir; gtag() çağrıları dataLayer'da kuyruklanır, olay kaybı olmaz. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BP7BT5C1X1');
      (function () {
        var yuklendi = false;
        function yukle() {
          if (yuklendi) return;
          yuklendi = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-BP7BT5C1X1';
          document.head.appendChild(s);
        }
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (e) {
          window.addEventListener(e, yukle, { once: true, passive: true });
        });
        window.addEventListener('load', function () { setTimeout(yukle, 4000); });
      })();
    </script>
    {lang === 'ar' && (
      <>
        {/* Arapça sayfalar Cairo ile dizilir — Poppins'te Arapça glif yok. */}
        <link rel="preload" href="/fonts/cairo-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/cairo-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
        <style is:inline set:html={`
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/cairo-arabic-400.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/cairo-latin-400.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/cairo-arabic-600.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/cairo-latin-600.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/cairo-arabic-700.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/cairo-latin-700.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/cairo-arabic-800.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
        @font-face { font-family: 'Cairo'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/cairo-latin-800.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
        html[lang="ar"], html[lang="ar"] body { font-family: 'Cairo', 'Poppins', system-ui, sans-serif; }
        /* Telefon, e-posta ve marka adları RTL akışında ters dizilmesin */
        html[lang="ar"] [dir="ltr"] { direction: ltr; unicode-bidi: isolate; text-align: start; }
        `} />
      </>
    )}
    <title>{title} | {s.seo.siteAdi}</title>
    <SEO title={title} description={aciklama} image={image} lang={lang} kimlik={kimlik} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-[100] focus:bg-eymen-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold focus:shadow-lg">{s.nav.icerigeGec}</a>
    <Header lang={lang} kimlik={kimlik} />
    <main id="icerik" tabindex="-1" class="flex-1 pt-20 lg:pt-[132px] outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <script>
      import { inject, track } from '@vercel/analytics';
      inject();

      // gtag() head'deki is:inline script'te tanımlı; gtag.js geç yüklendiği için
      // çağrılar dataLayer'da kuyruklanır ve script gelince işlenir (olay kaybı olmaz).
      function gtagSafe() {
        window.dataLayer = window.dataLayer || [];
        if (typeof window.gtag === 'function') window.gtag.apply(null, arguments);
        else window.dataLayer.push(arguments);
      }

      // Dönüşüm olayı — İKİ hedefe birden: Vercel Analytics (site analizi) +
      // GA4/Google Ads (dönüşüm sayımı). Ads yalnızca gtag tarafını görebilir.
      function send(name, props) {
        const p = props || {};
        try { track(name, p); } catch (e) {}
        try { gtagSafe('event', name, p); } catch (e) {}
      }

      // Form success dallarından çağrılabilsin diye global yardımcı
      window.trackEvent = (name, props) => send(name, props);

      // WhatsApp ve telefon tıklamalarını site genelinde yakala (event delegation)
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element ? e.target.closest('a') : null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        if (href.includes('wa.me')) {
          // Sosyal paylaşım linki (wa.me/?text=...) hariç → sadece bize yazan lead'ler
          if (!/wa\.me\/\?/.test(href)) {
            send('whatsapp_click', { path: location.pathname });
          }
        } else if (href.indexOf('tel:') === 0) {
          send('phone_click', { number: href.slice(4), path: location.pathname });
        }
      }, true);
    </script>
  </body>
</html>
