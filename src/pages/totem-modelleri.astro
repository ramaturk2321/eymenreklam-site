---
import BaseLayout from '../layouts/BaseLayout.astro';
import RehberLinkleri from '../components/RehberLinkleri.astro';
import { srcset, boyut } from '../lib/gorsel';
import { company, contact, getWhatsAppUrl } from '../lib/site-data';

// Totem modelleri galerisi (19 Kas 2026; 20 Kas: T-09–T-13 market/akaryakıt/AVM grubu). Çizimler: Documents/totem-modelleri/totem_uret.py (QCAD/DXF üreteci).
// Kural: fiyat, malzeme kalınlığı, profil, temel ölçüsü YAZILMAZ — yalnız dış ölçü ve fikir.
// Mockup'lardaki marka adları uydurmadır (LUNARA, NOVA, ARVEN, TAZEGÜN, ENERVA, ORVİA ...). Gerçek zincir markası (A101 vb.) KULLANILMAZ.
const title = 'Totem Tabela Modelleri – 13 Örnek ve Çizim';
const description = 'Market, akaryakıt, AVM ve kurumsal totem tabela modelleri: 13 örnek, ölçülü teknik çizim ve görsel. Pendik İstanbul’da üretim, keşif ücretsiz.';
const kapak = '/images/totem-modelleri/T-01.webp';
const pdf = '/eymen-reklam-totem-modelleri.pdf';

const modeller = [
  { kod: 'T-01', ad: 'Halka Monolit Totem', olcu: '4 m · 120 × 40 cm', yer: 'Rezidans, plaza, otel girişi',
    fikir: 'Gövdeden boydan boya yuvarlak bir açıklık geçer, kenarı LED ile yanar. Gece uzaktan halka olarak seçilir, gündüz arkasındaki gökyüzü görünür.',
    ozellik: ['Halka kenarı ışıklı', 'Marka adı arkadan aydınlatmalı harf', 'Kaidede kapı numarası'] },
  { kod: 'T-02', ad: 'Ahşap Lamelli Totem', olcu: '3 m · 90 × 25 cm', yer: 'Kafe, bistro, otel, klinik',
    fikir: 'Koyu zemin üzerinde ahşap görünümlü lameller, ortada dikey dizilmiş ışıklı harfler. Kaldırımda dar yere sığar, sıcak bir giriş görüntüsü verir.',
    ozellik: ['Dikey dizilmiş ışıklı harfler', 'Ahşap görünümlü lameller', 'İnce gövde, dar alana uygun'] },
  { kod: 'T-03', ad: 'Katmanlı Totem', olcu: '4,5 m · 140 × 50 cm', yer: 'Kurumsal ofis, fabrika, showroom',
    fikir: 'Biri koyu, biri kurumsal renkte iki plaka birbirinden kaydırılarak üst üste durur. Aradaki boşluk gölge oluşturur, totem gündüz de derinlikli görünür.',
    ozellik: ['Önde kurumsal renkli panel', 'Arkada büyük bina numarası', 'İki katman arası gölge etkisi'] },
  { kod: 'T-04', ad: 'Açılı Tepe Totem', olcu: '4 m · 100 × 35 cm', yer: 'Oto showroom, bayi, mağaza',
    fikir: 'Tepesi eğik kesilmiş gövde ve ön yüzü kaplayan tek parça ışıklı panel. Düz kutu totemden farklı, hareketli bir siluet verir.',
    ozellik: ['Eğik kesilmiş tepe', 'Ön yüz tek parça ışıklı', 'Logo, marka adı ve alt bilgi'] },
  { kod: 'T-05', ad: 'Corten Desenli Totem', olcu: '3,5 m · 100 × 30 cm', yer: 'Restoran, butik otel, villa sitesi',
    fikir: 'Pas görünümlü yüzeyde aşağıdan yukarı büyüyen delik deseni ve kesim harfler. Akşam arkadaki ışık desenden sızar.',
    ozellik: ['Lazer kesim desen', 'Arkadan ışık sızan harfler', 'Bahçe ve peyzajla uyumlu'] },
  { kod: 'T-06', ad: 'V Planlı Totem', olcu: '4,5 m · 164 × 77 cm', yer: 'Kavşak, ana yol, akaryakıt, AVM',
    fikir: 'Üstten bakınca V şeklindedir; iki yüz iki ayrı yola bakar. Köşe parsellerde her iki yönden gelen trafik logoyu düz karşıdan görür.',
    ozellik: ['İki yönden okunur', 'Her yüzde ayrı ışıklı panel', 'Köşe ve kavşak parselleri için'] },
  { kod: 'T-07', ad: 'Taş Sepet Kaideli Totem', olcu: '3,2 m · 120 × 60 cm', yer: 'Site girişi, fabrika, bahçeli işletme',
    fikir: 'Alt kısım taş doldurulmuş tel sepet, üstünde ışıklı logo paneli. Peyzajın bir parçası gibi durur, site ve tesis girişlerine yakışır.',
    ozellik: ['Taş dolu tel sepet kaide', 'Üstte ışıklı logo paneli', 'Blok ve yön bilgisi eklenebilir'] },
  { kod: 'T-08', ad: 'LED Ekranlı Totem', olcu: '5 m · 160 × 50 cm', yer: 'AVM, akaryakıt, eczane, plaza',
    fikir: 'Gövdeye dış mekân LED ekran yerleştirilir, üstte taşan ışıklı logo şapkası durur. Kampanya, duyuru ve video uzaktan değiştirilir.',
    ozellik: ['Dış mekân LED ekran', 'İçerik uzaktan değişir', 'Taşan ışıklı logo şapkası'] },
];

// 20 Kas 2026: zincir mağaza / market / akaryakıt / AVM tipleri (Ramazan Bey: "A101 tarzı"). Marka adları uydurma.
const marketModeller = [
  { kod: 'T-09', ad: 'Zincir Market Totemi', olcu: '6 m · 120 × 40 cm', yer: 'Market, zincir mağaza, eczane',
    fikir: 'Mahalle marketleri ve zincir mağazaların en çok kullandığı dikey totem. Üstte geniş ışıklı logo kaseti, gövdede çalışma saatleri ve otopark yönü.',
    ozellik: ['Üstte ışıklı logo kaseti', 'Çalışma saatleri paneli', 'Tüm şubelerde aynı ölçü ve renk'] },
  { kod: 'T-10', ad: 'Tek Direkli Pano Totem', olcu: '6 m · pano 240 × 160 cm', yer: 'Yol kenarı market, akaryakıt, bayi',
    fikir: 'Tek direğin tepesinde geniş ışıklı kutu pano. Yüksekte durduğu için ana yoldan, araçların üstünden okunur; zeminde az yer kaplar.',
    ozellik: ['Çift yüzlü ışıklı pano', 'Uzak mesafeden okunur', 'Dar zemine uygun'] },
  { kod: 'T-11', ad: 'Çift Ayaklı Pano Totem', olcu: '3,6 m · 260 × 30 cm', yer: 'Otopark girişi, iş merkezi, site, fabrika',
    fikir: 'İki ayak arasında geniş ışıklı pano, altında göz hizasında giriş ya da yön paneli. Uzun firma adları ve yatay logolar için rahat yer açar.',
    ozellik: ['Geniş yatay logo alanı', 'Altta giriş / yön paneli', 'Araç girişlerine uygun'] },
  { kod: 'T-12', ad: 'Akaryakıt Fiyat Totemi', olcu: '7 m · 160 × 50 cm', yer: 'Akaryakıt istasyonu, LPG, oto yıkama',
    fikir: 'Tepede ışıklı istasyon logosu, altında LED dijital fiyat göstergeleri ve market / kafe paneli. Fiyatlar totemin yanına gitmeden değiştirilir.',
    ozellik: ['LED dijital fiyat göstergesi', 'Işıklı istasyon logosu', 'Market ve kafe bilgi paneli'] },
  { kod: 'T-13', ad: 'AVM Çok Markalı Pylon', olcu: '9 m · 220 × 70 cm', yer: 'AVM, outlet, ticaret merkezi, plaza',
    fikir: 'Tepede taşan ışıklı AVM logosu, gövdede sekiz mağazaya ayrılmış ışıklı paneller. Mağaza değişince yalnız o panel değişir.',
    ozellik: ['Sekiz ayrı mağaza paneli', 'Paneller tek tek değiştirilir', 'Otopark girişi yönlendirmesi'] },
];

const gruplar = [
  { id: 'tasarim', baslik: 'Özgün tasarım totemler', aciklama: 'Kutu totemden farklı bir şey arayan markalar, ofisler, oteller ve showroomlar için.', liste: modeller },
  { id: 'market', baslik: 'Market, akaryakıt ve AVM totemleri', aciklama: 'Zincir mağaza, market, istasyon ve AVM önlerinde en çok kullanılan, yoldan uzaktan okunan totem tipleri.', liste: marketModeller },
];
const tumModeller = [...modeller, ...marketModeller];

// Sahadan gerçek işler — fotoğraflar sitede zaten var (proje sayfaları / totem ürün galerisi). Mockup/3D (ASKO, Meydan) KONMAZ.
const gercekIsler = [
  { ad: 'Unkar & Hak-et', is: 'Fabrika girişi, iki markalı totem', img: '/images/projeler/unkar-totem-1.webp', pos: '55% 50%', href: '/projelerimiz/unkar-totem/' },
  { ad: 'Beko · Bereket Mobilya', is: 'Mağaza önü, logo + kampanya paneli', img: '/images/projeler/beko-bereket-totem-3.webp', pos: '50% 50%', href: '/projelerimiz/beko-bereket-mobilya-totem/' },
  { ad: 'Fatih Üniversal Hayvan Hastanesi', is: 'Poliklinik ve acil yönlendirme totemi', img: '/images/urunler/totem-4.webp', pos: '50% 50%' },
  { ad: 'Anadolu Isuzu', is: 'Fabrika kavşağında iki yüzlü yön totemi', img: '/images/projeler/isuzu-yonlendirme.webp', pos: '50% 60%', href: '/projelerimiz/isuzu-yonlendirme/' },
  { ad: 'Banat Ambalaj', is: 'Fabrika girişi, kurumsal renkli totem', img: '/images/projeler/banat-totem-1.webp', pos: '42% 50%', href: '/projelerimiz/banat-totem/' },
  { ad: '2Plan Otomotiv Eskişehir', is: 'Showroom önü yol kenarı totemi', img: '/images/projeler/2plan-eskisehir-3.webp', pos: '50% 50%', href: '/projelerimiz/2plan-eskisehir/' },
  { ad: 'Bymet', is: 'Tesis girişi, ışıklı pilon tabela', img: '/images/urunler/totem-prj-1.webp', pos: '50% 40%' },
];

// Hero: gerçek işlerden üç fotoğraf (Banat, 2Plan, Beko). Render/mockup KONMAZ.
const hero = ['Banat Ambalaj', '2Plan Otomotiv Eskişehir', 'Beko · Bereket Mobilya'].map((ad) => gercekIsler.find((g) => g.ad === ad)!);

const waGenel = getWhatsAppUrl('Merhaba, totem modellerinize baktım. İşletmemiz için totem tabela düşünüyoruz. Firma adı ve kullanım yeri: ');
const waModel = (m: { kod: string; ad: string }) =>
  getWhatsAppUrl(`Merhaba, ${m.kod} ${m.ad} modeli için fiyat almak istiyorum. Firma adı, kullanım yeri ve istenen yükseklik: `);

const adimlar = [
  ['Modeli seçin', 'Beğendiğiniz modelin kodunu WhatsApp’tan ya da teklif formundan yazın. İki modeli birleştirmek de mümkün.'],
  ['Keşif ve ölçü', 'Yeri görüp yükseklik, genişlik, görüş mesafesi ve elektrik durumunu belirliyoruz.'],
  ['Markanıza göre çizim', 'Logonuz ve renklerinizle ölçülü çizim ve gerçekçi görsel hazırlıyoruz; onayınızdan sonra üretime geçiyoruz.'],
  ['Üretim ve montaj', 'Pendik’teki atölyemizde üretip temel, montaj ve elektrik bağlantısıyla teslim ediyoruz.'],
];

const faq = [
  { q: 'Bu modeller birebir aynı ölçüde mi yapılır?', a: 'Hayır. Çizimlerdeki ölçüler örnektir. Yükseklik, genişlik, renk ve aydınlatma yerinize ve görüş mesafesine göre değişir; modeli fikir olarak alıp markanıza göre yeniden ölçülendiriyoruz.' },
  { q: 'İki modeli birleştirebilir miyim?', a: 'Evet. Örneğin katmanlı totemin üstüne LED ekran, ahşap lamelli gövdeye taş sepet kaide eklenebilir. Keşifte birlikte karar veriyoruz.' },
  { q: 'Görsellerdeki marka adları gerçek mi?', a: 'Hayır, LUNARA, NOVA, TAZEGÜN, ENERVA, ORVİA gibi adlar örnek için uydurulmuştur. Çizim ve görsel sizin logonuz ve renklerinizle hazırlanır.' },
  { q: 'Totem için belediye izni gerekiyor mu?', a: 'Çoğu belediye totem tabela için ilan-reklam izni ister. İzin dosyası için gereken ölçülü çizimi biz hazırlıyoruz.' },
  { q: 'Teknik çizimi indirebilir miyim?', a: 'Evet. On üç modelin A3 teknik çizimlerini tek PDF olarak indirebilirsiniz. Projenize özel çizim keşiften sonra hazırlanır.' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: company.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Totem Tabela', item: `${company.siteUrl}/urunlerimiz/totem-tabela/` },
    { '@type': 'ListItem', position: 3, name: 'Totem Modelleri' },
  ],
};
const listSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Totem tabela modelleri',
  itemListElement: tumModeller.map((m, i) => ({
    '@type': 'ListItem', position: i + 1, name: `${m.kod} ${m.ad}`,
    image: `${company.siteUrl}/images/totem-modelleri/${m.kod}.webp`,
    url: `${company.siteUrl}/totem-modelleri/#${m.kod.toLowerCase()}`,
  })),
};
const kartSizes = '(min-width: 1280px) 290px, (min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw';
---

<BaseLayout title={title} description={description} image={kapak}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <nav class="bg-koyu-50 border-b border-koyu-100 py-3" aria-label="Sayfa yolu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-koyu-500">
        <li><a href="/" class="hover:text-eymen-600">Ana Sayfa</a></li>
        <li class="text-koyu-300">/</li>
        <li><a href="/urunlerimiz/totem-tabela/" class="hover:text-eymen-600">Totem Tabela</a></li>
        <li class="text-koyu-300">/</li>
        <li class="text-koyu-800 font-medium">Totem Modelleri</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-krem-100 border-b border-krem-200 pt-10 pb-10 md:pt-16 md:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-5 gap-8 items-center">
      <div class="lg:col-span-3">
        <h1 class="text-3xl md:text-5xl font-extrabold text-koyu-900 mb-4">Totem Tabela Modelleri ve Örnekleri</h1>
        <p class="text-koyu-700 text-base md:text-lg leading-relaxed mb-6">
          Kutu totemden farklı bir şey arayanlar için sekiz özgün model, market, akaryakıt ve AVM önleri için beş klasik totem tipi hazırladık.
          Her birinin ölçülü teknik çizimi ve gerçekçi görseli var. Hepsi Pendik’teki atölyemizde üretilebilir; birini seçin ya da ikisini birleştirin, markanıza göre yeniden çizelim.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={waGenel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-green-700 hover:bg-green-800 text-white px-6 py-3.5 rounded-xl font-bold transition-all">WhatsApp'tan model sorun</a>
          <a href={pdf} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border-2 border-koyu-300 hover:border-koyu-900 text-koyu-800 hover:bg-koyu-900/5 px-6 py-3.5 rounded-xl font-semibold transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
            Teknik çizimler (PDF, 13 sayfa)
          </a>
        </div>
        <!-- 28 Kas (Impeccable P1): reklamdan gelen kendi tipine tek dokunuşla atlasın -->
        <nav class="mt-6" aria-label="Model grupları">
          <p class="text-sm font-semibold text-koyu-800 mb-2">Doğrudan gidin:</p>
          <ul class="flex flex-wrap gap-2">
            {[
              ['#market', 'Market · akaryakıt · AVM'],
              ['#tasarim', 'Özgün tasarım totemler'],
              ['#sahadan', 'Ürettiğimiz totemler'],
            ].map(([href, ad]) => (
              <li><a href={href} class="inline-flex items-center min-h-11 px-4 rounded-full bg-white/80 border border-koyu-200 hover:border-koyu-800 text-sm font-semibold text-koyu-800 transition-colors">{ad}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <!-- 28 Kas (Impeccable P1): üstte yapay görsel yerine gerçek işler — "bunları gerçekten yapıyorlar mı" şüphesi -->
      <figure class="lg:col-span-2">
        <div class="grid grid-cols-3 gap-2">
          {hero.map((g, i) => (
            <img src={g.img} srcset={srcset(g.img)} sizes="(min-width: 1024px) 160px, 33vw" {...boyut(g.img)}
                 alt={`${g.ad} – ${g.is}, Eymen Reklam üretimi totem`} style={`object-position: ${g.pos}`}
                 class={`w-full aspect-[3/4] object-cover rounded-xl ${i === 1 ? 'mt-0' : 'mt-6'}`} loading="eager" decoding="async" fetchpriority={i === 1 ? 'high' : undefined} />
          ))}
        </div>
        <figcaption class="mt-3 text-sm text-koyu-700"><a href="#sahadan" class="font-semibold underline underline-offset-2 hover:text-koyu-900">Ürettiğimiz totemlerden</a>: {hero.map((g) => g.ad).join(', ')}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Modeller -->
  <section class="py-12 md:py-16 bg-white" aria-labelledby="modeller-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="modeller-baslik" class="sr-only">Totem tabela modelleri</h2>
      {gruplar.map((g, gi) => (
      <div id={g.id} class={`scroll-mt-24 ${gi ? 'mt-14 md:mt-16' : ''}`}>
      <h2 class="text-2xl md:text-3xl font-extrabold text-koyu-900">{g.baslik}</h2>
      <p class="text-koyu-600 mt-2 mb-6 max-w-3xl">{g.aciklama}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {g.liste.map((m) => {
          const img = `/images/totem-modelleri/${m.kod}.webp`;
          return (
            <article id={m.kod.toLowerCase()} class="group flex flex-col rounded-2xl border border-koyu-100 bg-white overflow-hidden hover:shadow-lg transition-shadow scroll-mt-24">
              <div class="relative">
                <img src={img} srcset={srcset(img)} sizes={kartSizes} {...boyut(img)} alt={`${m.ad} örnek görseli — ${m.yer}`}
                     class="w-full aspect-[3/4] object-cover" loading="lazy" decoding="async" />
                <span class="absolute top-3 left-3 bg-eymen-700 text-white text-xs font-bold px-2.5 py-1 rounded-md">{m.kod}</span>
              </div>
              <div class="flex flex-col flex-1 p-5">
                <h3 class="text-lg font-bold text-koyu-900">{m.ad}</h3>
                <p class="text-xs font-semibold text-eymen-700 mt-1">{m.olcu}</p>
                <p class="text-sm text-koyu-500 mt-1">{m.yer}</p>
                <!-- 28 Kas (Impeccable P1): mobilde kart 858 px idi → fikir 3 satır, özellikler yalnız geniş ekranda -->
                <p class="text-sm text-koyu-700 leading-relaxed mt-3 line-clamp-3 sm:line-clamp-none">{m.fikir}</p>
                <ul class="hidden sm:block mt-3 space-y-1 text-sm text-koyu-700">
                  {m.ozellik.map((o) => (
                    <li class="flex gap-2"><span class="text-eymen-600" aria-hidden="true">•</span>{o}</li>
                  ))}
                </ul>
                <!-- 28 Kas (Impeccable P1): tek ana eylem (WhatsApp, yeşil + simge, AA karşıtlık) + iki ikincil, hepsi ≥44 px -->
                <div class="mt-auto pt-5 flex flex-col gap-2">
                  <a href={waModel(m)} target="_blank" rel="noopener noreferrer"
                     class="inline-flex items-center justify-center gap-2 min-h-11 bg-green-700 hover:bg-green-800 text-white text-sm font-bold px-3 rounded-lg transition-colors">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp'tan fiyat iste
                  </a>
                  <div class="grid grid-cols-2 gap-2">
                    <button type="button" data-cizim={m.kod} data-ad={m.ad} data-wa={waModel(m)}
                            class="cizim-ac inline-flex items-center justify-center gap-1.5 min-h-11 border border-koyu-200 hover:border-koyu-800 text-koyu-800 text-sm font-semibold px-2 rounded-lg transition-colors">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16v14H4zM8 15l3-3 2 2 3-4"/></svg>
                      Çizim
                    </button>
                    <a href={`/teklif-al/?model=${m.kod}`}
                       class="inline-flex items-center justify-center min-h-11 border border-koyu-200 hover:border-koyu-800 text-koyu-800 text-sm font-semibold px-2 rounded-lg transition-colors">Teklif formu</a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      </div>
      ))}
      <p class="text-xs text-koyu-500 mt-6">Görsellerdeki marka adları örnektir. Ölçüler fikir vermek içindir; her proje yerine göre yeniden ölçülendirilir.</p>
    </div>
  </section>

  <!-- Gerçek işler -->
  <section id="sahadan" class="py-12 md:py-16 bg-koyu-900 scroll-mt-24" aria-labelledby="gercek-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-2">SAHADAN</p>
      <h2 id="gercek-baslik" class="text-2xl md:text-3xl font-extrabold text-white mb-2">Ürettiğimiz totemlerden</h2>
      <p class="text-koyu-300 mb-8 max-w-2xl">Yukarıdaki modeller fikir için. Bunlar Pendik'teki atölyemizde üretip yerine kurduğumuz gerçek totemler.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {gercekIsler.map((g) => {
          const Etiket = g.href ? 'a' : 'div';
          return (
            <Etiket href={g.href} class="group relative block overflow-hidden rounded-2xl bg-koyu-800 w-[calc(50%-0.5rem)] lg:w-[calc(25%-0.75rem)]">
              <img src={g.img} srcset={srcset(g.img)} sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, 50vw" {...boyut(g.img)}
                   alt={`${g.ad} – ${g.is}, Eymen Reklam üretimi totem tabela`}
                   class="w-full aspect-[4/5] object-cover group-hover:scale-105 transition-transform duration-500"
                   style={`object-position: ${g.pos}`} loading="lazy" decoding="async" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-koyu-900/95 via-koyu-900/70 to-transparent p-4 pt-12">
                <p class="text-white font-bold text-sm md:text-base leading-tight">{g.ad}</p>
                <p class="text-koyu-200 text-xs md:text-sm mt-0.5">{g.is}</p>
                {g.href && <p class="text-eymen-400 text-xs font-semibold mt-1.5">Projeyi gör →</p>}
              </div>
            </Etiket>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Teknik çizim penceresi -->
  <!-- 28 Kas (Impeccable P1): m-auto = Tailwind preflight dialog'u sol üste yapıştırıyordu; mobilde ekrana sığar; altta fiyat/teklif düğmeleri -->
  <dialog id="cizim-pencere" class="m-auto w-[min(96vw,1200px)] max-h-[94vh] rounded-2xl p-0 backdrop:bg-koyu-900/70 open:flex open:flex-col" aria-labelledby="cizim-baslik">
    <div class="flex items-center justify-between gap-4 px-4 py-3 border-b border-koyu-100">
      <h2 id="cizim-baslik" class="text-base font-bold text-koyu-900">Teknik çizim</h2>
      <div class="flex items-center gap-2 shrink-0">
        <a id="cizim-yeni" href="#" target="_blank" rel="noopener" class="whitespace-nowrap text-sm text-koyu-600 hover:text-eymen-700 underline underline-offset-2">Büyük aç</a>
        <button type="button" id="cizim-kapat" class="p-2.5 rounded-lg hover:bg-koyu-100" aria-label="Kapat">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <div class="flex-1 min-h-0 overflow-auto bg-white">
      <img id="cizim-resim" src="/images/totem-modelleri/cizim/T-01.svg" alt="T-01 Halka Monolit Totem teknik çizimi" width="1000" height="707" class="block w-full h-auto aspect-[1000/707] lg:min-w-[720px]" />
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 px-4 py-3 border-t border-koyu-100 bg-white">
      <p id="cizim-not" class="hidden sm:block flex-1 text-sm text-koyu-600">Ölçüler örnektir; yerinize ve logonuza göre yeniden çizilir.</p>
      <a id="cizim-wa" href={waGenel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-green-700 hover:bg-green-800 text-white text-sm font-bold px-4 py-3 rounded-lg transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp'tan bu modelin fiyatını isteyin
      </a>
      <a id="cizim-form" href="/teklif-al/" class="inline-flex items-center justify-center border border-koyu-200 hover:border-koyu-800 text-koyu-800 text-sm font-semibold px-4 py-3 rounded-lg transition-colors">Teklif formuyla gönderin</a>
    </div>
  </dialog>

  <!-- Süreç -->
  <section class="py-12 md:py-16 bg-koyu-50 border-y border-koyu-100" aria-labelledby="surec-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="surec-baslik" class="text-2xl md:text-3xl font-extrabold text-koyu-900 mb-8">Modelden toteme: nasıl ilerliyoruz?</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {adimlar.map(([b, a], i) => (
          <li class="rounded-2xl bg-white border border-koyu-100 p-5">
            <span class="inline-flex w-8 h-8 items-center justify-center rounded-full bg-eymen-600 text-white text-sm font-bold mb-3">{i + 1}</span>
            <h3 class="font-bold text-koyu-900 mb-1">{b}</h3>
            <p class="text-sm text-koyu-600 leading-relaxed">{a}</p>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 text-sm">
        <a href="/urunlerimiz/totem-tabela/" class="inline-flex items-center gap-1 font-semibold text-eymen-700 hover:text-eymen-800">Totem tabela imalatı ve fiyatı neye göre belirlenir →</a>
        <a href="/statik-hesap/" class="inline-flex items-center gap-1 font-semibold text-eymen-700 hover:text-eymen-800">Totem temel hesabı aracı →</a>
      </div>
    </div>
  </section>

  <RehberLinkleri />

  <!-- SSS -->
  <section class="py-12 md:py-16 bg-white" aria-labelledby="sss-baslik">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="sss-baslik" class="text-2xl md:text-3xl font-extrabold text-koyu-900 mb-6">Sık sorulan sorular</h2>
      <div class="divide-y divide-koyu-100 border-y border-koyu-100">
        {faq.map((f) => (
          <details class="group py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-koyu-900">
              {f.q}
              <span class="text-eymen-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm text-koyu-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-10 rounded-2xl bg-krem-100 border border-krem-200 p-6 text-center">
        <p class="font-bold text-koyu-900 mb-1">Yerinizi ve logonuzu gönderin, modeli markanıza göre çizelim.</p>
        <p class="text-sm text-koyu-600 mb-4">Keşif ücretsiz. <a href={contact.phoneHref} class="inline-flex items-center min-h-11 font-semibold text-koyu-900 underline underline-offset-2 hover:text-eymen-700">{contact.phone}</a></p>
        <a href={waGenel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-green-700 hover:bg-green-800 text-white px-6 py-3 rounded-xl font-bold transition-all">WhatsApp'tan yazın</a>
      </div>
    </div>
  </section>

  <script>
    const pencere = document.getElementById('cizim-pencere') as HTMLDialogElement | null;
    const resim = document.getElementById('cizim-resim') as HTMLImageElement | null;
    const baslik = document.getElementById('cizim-baslik');
    const yeni = document.getElementById('cizim-yeni') as HTMLAnchorElement | null;
    const wa = document.getElementById('cizim-wa') as HTMLAnchorElement | null;
    const form = document.getElementById('cizim-form') as HTMLAnchorElement | null;
    let acikModel = '';
    document.querySelectorAll<HTMLButtonElement>('.cizim-ac').forEach((b) => {
      b.addEventListener('click', () => {
        if (!pencere || !resim) return;
        const src = `/images/totem-modelleri/cizim/${b.dataset.cizim}.svg`;
        acikModel = b.dataset.cizim || '';
        resim.src = src;
        resim.alt = `${b.dataset.cizim} ${b.dataset.ad} teknik çizimi: ön, yan ve üstten görünüş, ölçüler`;
        if (baslik) baslik.textContent = `${b.dataset.cizim} ${b.dataset.ad} — teknik çizim`;
        if (yeni) yeni.href = src;
        if (wa && b.dataset.wa) wa.href = b.dataset.wa;
        if (form) form.href = `/teklif-al/?model=${acikModel}`;
        pencere.showModal();
        if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'totem_cizim_ac', { model: acikModel });
      });
    });
    wa?.addEventListener('click', () => {
      if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'totem_cizim_wa', { model: acikModel });
    });
    // Çizim ~150 KB: yalnız düğmeye yaklaşılınca o modeli önceden yükle (13'ünü birden indirmek mobilde 2 MB)
    const yuklendi = new Set<string>();
    document.querySelectorAll<HTMLButtonElement>('.cizim-ac').forEach((b) => {
      const yukle = () => { const k = b.dataset.cizim || ''; if (yuklendi.has(k)) return; yuklendi.add(k); new Image().src = `/images/totem-modelleri/cizim/${k}.svg`; };
      b.addEventListener('pointerenter', yukle, { once: true });
      b.addEventListener('touchstart', yukle, { once: true, passive: true });
      b.addEventListener('focus', yukle, { once: true });
    });
    document.getElementById('cizim-kapat')?.addEventListener('click', () => pencere?.close());
    pencere?.addEventListener('click', (e) => { if (e.target === pencere) pencere.close(); });
  </script>
</BaseLayout>
