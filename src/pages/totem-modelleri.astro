---
import BaseLayout from '../layouts/BaseLayout.astro';
import { srcset, boyut } from '../lib/gorsel';
import { company, contact, getWhatsAppUrl } from '../lib/site-data';

// Totem modelleri galerisi (19 Kas 2026). Çizimler: Documents/totem-modelleri/totem_uret.py (QCAD/DXF üreteci).
// Kural: fiyat, malzeme kalınlığı, profil, temel ölçüsü YAZILMAZ — yalnız dış ölçü ve fikir.
// Mockup'lardaki marka adları uydurmadır (LUNARA, NOVA, ARVEN ...).
const title = 'Totem Tabela Modelleri – 8 Fikir, Ölçülü Çizim';
const description = 'Halka monolit, ahşap lamelli, katmanlı, corten desenli, V planlı, taş kaideli ve LED ekranlı totem tabela modelleri. Her model ölçülü teknik çizim ve gerçekçi görselle; markanıza göre üretiyoruz.';
const kapak = '/images/totem-modelleri/T-01.webp';
const pdf = '/eymen-reklam-totem-modelleri.pdf';

const modeller = [
  { kod: 'T-01', ad: 'Halka Monolit Totem', olcu: '4 m · 120 × 40 cm', yer: 'Rezidans, plaza, otel girişi',
    fikir: 'Gövdeden boydan boya yuvarlak bir açıklık geçer, kenarı LED ile yanar. Gece uzaktan halka olarak seçilir, gündüz arkasındaki gökyüzü görünür.',
    ozellik: ['Halka kenarı ışıklı', 'Marka adı arkadan aydınlatmalı harf', 'Kaidede kapı numarası'] },
  { kod: 'T-02', ad: 'Ahşap Lamelli Totem', olcu: '3 m · 90 × 25 cm', yer: 'Kafe, bistro, otel, klinik',
    fikir: 'Koyu zemin üzerinde ahşap görünümlü lameller, ortada dikey dizilmiş ışıklı harfler. Kaldırımda dar yere sığar, sıcak bir giriş görüntüsü verir.',
    ozellik: ['Dikey dizilmiş ışıklı harfler', 'Ahşap görünümlü lameller', 'İnce gövde, dar alana uygun'] },
  { kod: 'T-03', ad: 'Katmanlı Totem', olcu: '4,5 m · 140 × 50 cm', yer: 'Kurumsal ofis, fabrika, showroom',
    fikir: 'Biri koyu, biri kurumsal renkte iki plaka birbirinden kaydırılarak üst üste durur. Aradaki boşluk gölge oluşturur, totem gündüz de derinlikli görünür.',
    ozellik: ['Önde kurumsal renkli panel', 'Arkada büyük bina numarası', 'İki katman arası gölge etkisi'] },
  { kod: 'T-04', ad: 'Açılı Tepe Totem', olcu: '4 m · 100 × 35 cm', yer: 'Oto showroom, bayi, mağaza',
    fikir: 'Tepesi eğik kesilmiş gövde ve ön yüzü kaplayan tek parça ışıklı panel. Düz kutu totemden farklı, hareketli bir siluet verir.',
    ozellik: ['Eğik kesilmiş tepe', 'Ön yüz tek parça ışıklı', 'Logo, marka adı ve alt bilgi'] },
  { kod: 'T-05', ad: 'Corten Desenli Totem', olcu: '3,5 m · 100 × 30 cm', yer: 'Restoran, butik otel, villa sitesi',
    fikir: 'Pas görünümlü yüzeyde aşağıdan yukarı büyüyen delik deseni ve kesim harfler. Akşam arkadaki ışık desenden sızar.',
    ozellik: ['Lazer kesim desen', 'Arkadan ışık sızan harfler', 'Bahçe ve peyzajla uyumlu'] },
  { kod: 'T-06', ad: 'V Planlı Totem', olcu: '4,5 m · 164 × 77 cm', yer: 'Kavşak, ana yol, akaryakıt, AVM',
    fikir: 'Üstten bakınca V şeklindedir; iki yüz iki ayrı yola bakar. Köşe parsellerde her iki yönden gelen trafik logoyu düz karşıdan görür.',
    ozellik: ['İki yönden okunur', 'Her yüzde ayrı ışıklı panel', 'Köşe ve kavşak parselleri için'] },
  { kod: 'T-07', ad: 'Taş Sepet Kaideli Totem', olcu: '3,2 m · 120 × 60 cm', yer: 'Site girişi, fabrika, bahçeli işletme',
    fikir: 'Alt kısım taş doldurulmuş tel sepet, üstünde ışıklı logo paneli. Peyzajın bir parçası gibi durur, site ve tesis girişlerine yakışır.',
    ozellik: ['Taş dolu tel sepet kaide', 'Üstte ışıklı logo paneli', 'Blok ve yön bilgisi eklenebilir'] },
  { kod: 'T-08', ad: 'LED Ekranlı Totem', olcu: '5 m · 160 × 50 cm', yer: 'AVM, akaryakıt, eczane, plaza',
    fikir: 'Gövdeye dış mekân LED ekran yerleştirilir, üstte taşan ışıklı logo şapkası durur. Kampanya, duyuru ve video uzaktan değiştirilir.',
    ozellik: ['Dış mekân LED ekran', 'İçerik uzaktan değişir', 'Taşan ışıklı logo şapkası'] },
];

// Sahadan gerçek işler — fotoğraflar sitede zaten var (proje sayfaları / totem ürün galerisi). Mockup/3D (ASKO, Meydan) KONMAZ.
const gercekIsler = [
  { ad: 'Unkar & Hak-et', is: 'Fabrika girişi, iki markalı totem', img: '/images/projeler/unkar-totem-1.webp', pos: '55% 50%', href: '/projelerimiz/unkar-totem/' },
  { ad: 'Beko · Bereket Mobilya', is: 'Mağaza önü, logo + kampanya paneli', img: '/images/projeler/beko-bereket-totem-3.webp', pos: '50% 50%', href: '/projelerimiz/beko-bereket-mobilya-totem/' },
  { ad: 'Fatih Üniversal Hayvan Hastanesi', is: 'Poliklinik ve acil yönlendirme totemi', img: '/images/urunler/totem-4.webp', pos: '50% 50%' },
  { ad: 'Anadolu Isuzu', is: 'Fabrika kavşağında iki yüzlü yön totemi', img: '/images/projeler/isuzu-yonlendirme.webp', pos: '50% 60%', href: '/projelerimiz/isuzu-yonlendirme/' },
  { ad: 'Banat Ambalaj', is: 'Fabrika girişi, kurumsal renkli totem', img: '/images/projeler/banat-totem-1.webp', pos: '42% 50%', href: '/projelerimiz/banat-totem/' },
  { ad: '2Plan Otomotiv Eskişehir', is: 'Showroom önü yol kenarı totemi', img: '/images/projeler/2plan-eskisehir-3.webp', pos: '50% 50%', href: '/projelerimiz/2plan-eskisehir/' },
  { ad: 'Bymet', is: 'Tesis girişi, ışıklı pilon tabela', img: '/images/urunler/totem-prj-1.webp', pos: '50% 40%' },
];

const waGenel = getWhatsAppUrl('Merhaba, totem modellerinize baktım. İşletmemiz için totem tabela düşünüyoruz. Firma adı ve kullanım yeri: ');
const waModel = (m: { kod: string; ad: string }) =>
  getWhatsAppUrl(`Merhaba, ${m.kod} ${m.ad} modeli için fiyat almak istiyorum. Firma adı, kullanım yeri ve istenen yükseklik: `);

const adimlar = [
  ['Modeli seçin', 'Beğendiğiniz modelin kodunu WhatsApp’tan ya da teklif formundan yazın. İki modeli birleştirmek de mümkün.'],
  ['Keşif ve ölçü', 'Yeri görüp yükseklik, genişlik, görüş mesafesi ve elektrik durumunu belirliyoruz.'],
  ['Markanıza göre çizim', 'Logonuz ve renklerinizle ölçülü çizim ve gerçekçi görsel hazırlıyoruz; onayınızdan sonra üretime geçiyoruz.'],
  ['Üretim ve montaj', 'Pendik’teki atölyemizde üretip temel, montaj ve elektrik bağlantısıyla teslim ediyoruz.'],
];

const faq = [
  { q: 'Bu modeller birebir aynı ölçüde mi yapılır?', a: 'Hayır. Çizimlerdeki ölçüler örnektir. Yükseklik, genişlik, renk ve aydınlatma yerinize ve görüş mesafesine göre değişir; modeli fikir olarak alıp markanıza göre yeniden ölçülendiriyoruz.' },
  { q: 'İki modeli birleştirebilir miyim?', a: 'Evet. Örneğin katmanlı totemin üstüne LED ekran, ahşap lamelli gövdeye taş sepet kaide eklenebilir. Keşifte birlikte karar veriyoruz.' },
  { q: 'Görsellerdeki marka adları gerçek mi?', a: 'Hayır, LUNARA, NOVA, ARVEN gibi adlar örnek için uydurulmuştur. Çizim ve görsel sizin logonuz ve renklerinizle hazırlanır.' },
  { q: 'Totem için belediye izni gerekiyor mu?', a: 'Çoğu belediye totem tabela için ilan-reklam izni ister. İzin dosyası için gereken ölçülü çizimi biz hazırlıyoruz.' },
  { q: 'Teknik çizimi indirebilir miyim?', a: 'Evet. Sekiz modelin A3 teknik çizimlerini tek PDF olarak indirebilirsiniz. Projenize özel çizim keşiften sonra hazırlanır.' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: company.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Totem Tabela', item: `${company.siteUrl}/urunlerimiz/totem-tabela/` },
    { '@type': 'ListItem', position: 3, name: 'Totem Modelleri' },
  ],
};
const listSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Totem tabela modelleri',
  itemListElement: modeller.map((m, i) => ({
    '@type': 'ListItem', position: i + 1, name: `${m.kod} ${m.ad}`,
    image: `${company.siteUrl}/images/totem-modelleri/${m.kod}.webp`,
    url: `${company.siteUrl}/totem-modelleri/#${m.kod.toLowerCase()}`,
  })),
};
const kartSizes = '(min-width: 1280px) 290px, (min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw';
---

<BaseLayout title={title} description={description} image={kapak}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <nav class="bg-koyu-50 border-b border-koyu-100 py-3" aria-label="Sayfa yolu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-koyu-500">
        <li><a href="/" class="hover:text-eymen-600">Ana Sayfa</a></li>
        <li class="text-koyu-300">/</li>
        <li><a href="/urunlerimiz/totem-tabela/" class="hover:text-eymen-600">Totem Tabela</a></li>
        <li class="text-koyu-300">/</li>
        <li class="text-koyu-800 font-medium">Totem Modelleri</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-krem-100 border-b border-krem-200 pt-10 pb-10 md:pt-16 md:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-5 gap-8 items-center">
      <div class="lg:col-span-3">
        <p class="text-eymen-700 text-sm font-semibold tracking-wider mb-3">FİKİR KATALOĞU · 8 MODEL</p>
        <h1 class="text-3xl md:text-5xl font-extrabold text-koyu-900 mb-4">Totem Tabela Modelleri</h1>
        <p class="text-koyu-700 text-base md:text-lg leading-relaxed mb-6">
          Kutu totemden farklı bir şey arayanlar için sekiz model hazırladık. Her birinin ölçülü teknik çizimi ve gerçekçi görseli var.
          Hepsi atölyemizde üretilebilir; birini seçin ya da ikisini birleştirin, markanıza göre yeniden çizelim.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={waGenel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3.5 rounded-xl font-bold transition-all">WhatsApp'tan model sorun</a>
          <a href={pdf} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border-2 border-koyu-300 hover:border-koyu-900 text-koyu-800 hover:bg-koyu-900/5 px-6 py-3.5 rounded-xl font-semibold transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
            Teknik çizimler (PDF, 8 sayfa)
          </a>
        </div>
      </div>
      <div class="lg:col-span-2 grid grid-cols-3 gap-2" aria-hidden="true">
        {['T-05', 'T-01', 'T-08'].map((k, i) => (
          <img src={`/images/totem-modelleri/${k}.webp`} srcset={srcset(`/images/totem-modelleri/${k}.webp`)} sizes="(min-width: 1024px) 160px, 33vw"
               {...boyut(`/images/totem-modelleri/${k}.webp`)} alt="" class={`w-full aspect-[3/4] object-cover rounded-xl ${i === 1 ? 'mt-0' : 'mt-6'}`} loading="eager" decoding="async" />
        ))}
      </div>
    </div>
  </section>

  <!-- Modeller -->
  <section class="py-12 md:py-16 bg-white" aria-labelledby="modeller-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="modeller-baslik" class="sr-only">Modeller</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {modeller.map((m) => {
          const img = `/images/totem-modelleri/${m.kod}.webp`;
          return (
            <article id={m.kod.toLowerCase()} class="group flex flex-col rounded-2xl border border-koyu-100 bg-white overflow-hidden hover:shadow-lg transition-shadow scroll-mt-24">
              <div class="relative">
                <img src={img} srcset={srcset(img)} sizes={kartSizes} {...boyut(img)} alt={`${m.ad} örnek görseli — ${m.yer}`}
                     class="w-full aspect-[3/4] object-cover" loading="lazy" decoding="async" />
                <span class="absolute top-3 left-3 bg-eymen-600 text-white text-xs font-bold px-2.5 py-1 rounded-md">{m.kod}</span>
              </div>
              <div class="flex flex-col flex-1 p-5">
                <h3 class="text-lg font-bold text-koyu-900">{m.ad}</h3>
                <p class="text-xs font-semibold text-eymen-700 mt-1">{m.olcu}</p>
                <p class="text-sm text-koyu-500 mt-1">{m.yer}</p>
                <p class="text-sm text-koyu-700 leading-relaxed mt-3">{m.fikir}</p>
                <ul class="mt-3 space-y-1 text-sm text-koyu-700">
                  {m.ozellik.map((o) => (
                    <li class="flex gap-2"><span class="text-eymen-600" aria-hidden="true">•</span>{o}</li>
                  ))}
                </ul>
                <div class="mt-auto pt-5 grid grid-cols-2 gap-2">
                  <button type="button" data-cizim={m.kod} data-ad={m.ad}
                          class="cizim-ac inline-flex items-center justify-center gap-1.5 border border-koyu-200 hover:border-koyu-800 text-koyu-800 text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16v14H4zM8 15l3-3 2 2 3-4"/></svg>
                    Çizim
                  </button>
                  <a href={waModel(m)} target="_blank" rel="noopener noreferrer"
                     class="inline-flex items-center justify-center bg-eymen-600 hover:bg-eymen-700 text-white text-sm font-bold px-3 py-2.5 rounded-lg transition-colors">Fiyat iste</a>
                </div>
                <a href={`/teklif-al/?model=${m.kod}`} class="mt-2 text-center text-xs text-koyu-600 hover:text-eymen-700 underline underline-offset-2">ya da teklif formuyla gönderin</a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="text-xs text-koyu-500 mt-6">Görsellerdeki marka adları örnektir. Ölçüler fikir vermek içindir; her proje yerine göre yeniden ölçülendirilir.</p>
    </div>
  </section>

  <!-- Gerçek işler -->
  <section class="py-12 md:py-16 bg-koyu-900" aria-labelledby="gercek-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-2">SAHADAN</p>
      <h2 id="gercek-baslik" class="text-2xl md:text-3xl font-extrabold text-white mb-2">Ürettiğimiz totemlerden</h2>
      <p class="text-koyu-300 mb-8 max-w-2xl">Yukarıdaki modeller fikir için. Bunlar Pendik'teki atölyemizde üretip yerine kurduğumuz gerçek totemler.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {gercekIsler.map((g) => {
          const Etiket = g.href ? 'a' : 'div';
          return (
            <Etiket href={g.href} class="group relative block overflow-hidden rounded-2xl bg-koyu-800 w-[calc(50%-0.5rem)] lg:w-[calc(25%-0.75rem)]">
              <img src={g.img} srcset={srcset(g.img)} sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, 50vw" {...boyut(g.img)}
                   alt={`${g.ad} – ${g.is}, Eymen Reklam üretimi totem tabela`}
                   class="w-full aspect-[4/5] object-cover group-hover:scale-105 transition-transform duration-500"
                   style={`object-position: ${g.pos}`} loading="lazy" decoding="async" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-koyu-900/95 via-koyu-900/70 to-transparent p-4 pt-12">
                <p class="text-white font-bold text-sm md:text-base leading-tight">{g.ad}</p>
                <p class="text-koyu-200 text-xs md:text-sm mt-0.5">{g.is}</p>
                {g.href && <p class="text-eymen-400 text-xs font-semibold mt-1.5">Projeyi gör →</p>}
              </div>
            </Etiket>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Teknik çizim penceresi -->
  <dialog id="cizim-pencere" class="w-[min(96vw,1200px)] max-h-[94vh] rounded-2xl p-0 backdrop:bg-koyu-900/70" aria-labelledby="cizim-baslik">
    <div class="flex items-center justify-between gap-4 px-4 py-3 border-b border-koyu-100">
      <h2 id="cizim-baslik" class="text-base font-bold text-koyu-900">Teknik çizim</h2>
      <div class="flex items-center gap-2">
        <a id="cizim-yeni" href="#" target="_blank" rel="noopener" class="text-sm text-koyu-600 hover:text-eymen-700 underline underline-offset-2">Büyük aç</a>
        <button type="button" id="cizim-kapat" class="p-2 rounded-lg hover:bg-koyu-100" aria-label="Kapat">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <div class="overflow-auto bg-white">
      <img id="cizim-resim" src="/images/totem-modelleri/cizim/T-01.svg" alt="T-01 Halka Monolit Totem teknik çizimi" loading="lazy" width="1000" height="707" class="w-full h-auto min-w-[720px]" />
    </div>
  </dialog>

  <!-- Süreç -->
  <section class="py-12 md:py-16 bg-koyu-50 border-y border-koyu-100" aria-labelledby="surec-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="surec-baslik" class="text-2xl md:text-3xl font-extrabold text-koyu-900 mb-8">Modelden toteme: nasıl ilerliyoruz?</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {adimlar.map(([b, a], i) => (
          <li class="rounded-2xl bg-white border border-koyu-100 p-5">
            <span class="inline-flex w-8 h-8 items-center justify-center rounded-full bg-eymen-600 text-white text-sm font-bold mb-3">{i + 1}</span>
            <h3 class="font-bold text-koyu-900 mb-1">{b}</h3>
            <p class="text-sm text-koyu-600 leading-relaxed">{a}</p>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 text-sm">
        <a href="/urunlerimiz/totem-tabela/" class="inline-flex items-center gap-1 font-semibold text-eymen-700 hover:text-eymen-800">Totem tabela imalatı ve fiyatı neye göre belirlenir →</a>
        <a href="/statik-hesap/" class="inline-flex items-center gap-1 font-semibold text-eymen-700 hover:text-eymen-800">Totem temel hesabı aracı →</a>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-12 md:py-16 bg-white" aria-labelledby="sss-baslik">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="sss-baslik" class="text-2xl md:text-3xl font-extrabold text-koyu-900 mb-6">Sık sorulan sorular</h2>
      <div class="divide-y divide-koyu-100 border-y border-koyu-100">
        {faq.map((f) => (
          <details class="group py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-koyu-900">
              {f.q}
              <span class="text-eymen-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm text-koyu-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-10 rounded-2xl bg-krem-100 border border-krem-200 p-6 text-center">
        <p class="font-bold text-koyu-900 mb-1">Yerinizi ve logonuzu gönderin, modeli markanıza göre çizelim.</p>
        <p class="text-sm text-koyu-600 mb-4">Keşif ücretsiz. {contact.phone}</p>
        <a href={waGenel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-bold transition-all">WhatsApp'tan yazın</a>
      </div>
    </div>
  </section>

  <script>
    const pencere = document.getElementById('cizim-pencere') as HTMLDialogElement | null;
    const resim = document.getElementById('cizim-resim') as HTMLImageElement | null;
    const baslik = document.getElementById('cizim-baslik');
    const yeni = document.getElementById('cizim-yeni') as HTMLAnchorElement | null;
    document.querySelectorAll<HTMLButtonElement>('.cizim-ac').forEach((b) => {
      b.addEventListener('click', () => {
        if (!pencere || !resim) return;
        const src = `/images/totem-modelleri/cizim/${b.dataset.cizim}.svg`;
        resim.src = src;
        resim.alt = `${b.dataset.cizim} ${b.dataset.ad} teknik çizimi: ön, yan ve üstten görünüş, ölçüler`;
        if (baslik) baslik.textContent = `${b.dataset.cizim} ${b.dataset.ad} — teknik çizim`;
        if (yeni) yeni.href = src;
        pencere.showModal();
        if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'totem_cizim_ac', { model: b.dataset.cizim });
      });
    });
    document.getElementById('cizim-kapat')?.addEventListener('click', () => pencere?.close());
    pencere?.addEventListener('click', (e) => { if (e.target === pencere) pencere.close(); });
  </script>
</BaseLayout>
