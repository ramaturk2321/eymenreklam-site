---
import BaseLayout from '../layouts/BaseLayout.astro';
import { srcset, boyut } from '../lib/gorsel';
import { company, contact, getWhatsAppUrl } from '../lib/site-data';

// Anadolu Yakası UV baskı iniş sayfası (19 Eyl 2026). Pendik odaklı hizmet sayfası: /hizmetlerimiz/uv-baski/
// Fiyat aralığı / rakam YAZILMAZ (Ramazan kararı).
const title = 'Anadolu Yakası UV Baskı – 4x2 m Flatbed';
const description = "Kadıköy'den Gebze'ye Anadolu Yakası UV baskı: cam, pleksi, ahşap, metal ve kompozite 4x2 m SwissQprint flatbed ile doğrudan baskı. Pendik tesisinde üretim, kesim ve montaj dâhil.";
const heroImage = '/images/urunler/uv-flatbed-1.webp';
const wa = getWhatsAppUrl('Merhaba, firmamız adına Anadolu Yakası\'nda UV baskı için teklif almak istiyorum. Firma adı, malzeme, ölçü ve adet: ');

const ilceler = [
  { ad: 'Kadıköy', not: 'Mağaza içi panolar, cam bölme ve ofis yönlendirmeleri' },
  { ad: 'Ataşehir', not: 'AVM mağazaları, plaza ofisleri; Water Garden ve Bulvar 216 çevresi' },
  { ad: 'Ümraniye', not: 'Şerifali ve Dudullu sanayi bölgesi iş güvenliği levhaları' },
  { ad: 'Üsküdar', not: 'Klinik, okul ve kurum iç mekân görselleri' },
  { ad: 'Maltepe', not: 'Mağaza ve showroom cephe panoları' },
  { ad: 'Kartal', not: 'Plaza ve fabrika yönlendirme sistemleri' },
  { ad: 'Pendik', not: 'Tesisimizin bulunduğu ilçe; aynı gün teslim ve montaj' },
  { ad: 'Tuzla', not: 'Organize sanayi ve tersane bölgesi levha ve panoları' },
  { ad: 'Sancaktepe', not: 'Depo ve lojistik tesisleri için dekota levhalar' },
  { ad: 'Çekmeköy', not: 'Site ve okul yönlendirme panoları' },
  { ad: 'Sultanbeyli', not: 'Mağaza ve işyeri iç mekân uygulamaları' },
  { ad: 'Beykoz', not: 'Otel, restoran ve mimari dekor baskıları' },
  { ad: 'Gebze / Darıca', not: 'GOSB ve Dilovası fabrikaları için iş güvenliği ve yönlendirme levhaları' },
];

const malzemeler = [
  ['Cam ve ayna', 'Beyaz altbaskılı görseller, bölme camı, vitrin panosu'],
  ['Pleksi (akrilik)', 'Ofis tabelası, ışıklı pano yüzeyi, ürün teşhir'],
  ['Ahşap ve MDF', 'Dekoratif duvar panosu, mobilya yüzeyi, hediyelik'],
  ['Alüminyum ve kompozit', 'Yönlendirme tabelası, kapı isimliği, dış mekân levha'],
  ['Dekota ve foreks', 'İş güvenliği levhaları, mağaza içi kampanya panoları'],
  ['Deri, PVC ve laminat', 'Promosyon ürünleri, ajanda kapağı, kişiselleştirme'],
];

const isler = [
  { ad: 'Ülker', isler: 'Promosyon ürünleri için cam üzerine UV baskı ve laminasyon.', href: '/projelerimiz/ulker-uv-baski/' },
  { ad: 'A101 lojistik deposu', isler: 'Yönlendirme tabelaları, bölüm isimlikleri ve iş güvenliği levhaları.', href: '/projelerimiz/a101-depo/' },
  { ad: 'İş güvenliği levhaları — seri üretim', isler: 'Şantiye ve fabrikalar için dekota üzerine UV baskı uyarı ve tehlike levhaları.', href: '/projelerimiz/is-guvenligi-uv/' },
  { ad: 'PAWCO — Kozzy AVM ve Water Garden', isler: 'Mağaza içi panolar, lightbox duvarı ve cam folyo uygulamaları.', href: '/projelerimiz/pawco-kozzy-avm/' },
  { ad: '2Plan Otomotiv — Etiler', isler: 'Bina cephesinde UV baskı ve vinil germe.', href: '/projelerimiz/etiler-2plan/' },
  { ad: 'UV flatbed üretim süreci', isler: 'Fotoğraf kalitesinde levha baskısı ve UV LED kürleme; tesisimizden kareler.', href: '/projelerimiz/flatbed-uv-uretim/' },
];

const faq = [
  { q: "Anadolu Yakası'nın hangi ilçelerine UV baskı yapıyorsunuz?", a: "Kadıköy, Ataşehir, Ümraniye, Üsküdar, Maltepe, Kartal, Pendik, Tuzla, Sancaktepe, Çekmeköy, Sultanbeyli ve Beykoz'a keşif ve montaj dâhil hizmet veriyoruz. Gebze ve Darıca'ya araçla, diğer illere paketli kargo ile gönderiyoruz." },
  { q: 'UV baskı fiyatı neye göre belirlenir?', a: 'Malzeme türü, baskı alanı (m²), adet, beyaz altbaskı veya vernik katmanı, şekilli kesim ihtiyacı ve teslim süresi. Liste fiyatı yayınlamıyoruz; malzeme, ölçü ve adedi WhatsApp\'tan yazarsanız aynı gün net fiyat veriyoruz.' },
  { q: 'Kendi malzememi getirebilir miyim?', a: 'Evet. Cam, pleksi, MDF, kompozit veya hazır ürününüzü Pendik tesisimize getirirseniz yalnızca baskı ücreti ödersiniz. Malzemeyi biz temin edersek levha bedeli eklenir.' },
  { q: 'Ne kadar sürede teslim edersiniz?', a: 'Standart işler dosya onayından sonra birkaç iş günü içinde hazır olur. Pendik ve yakın ilçelerde acil işlerde aynı gün üretim, ertesi gün montaj planlayabiliyoruz.' },
  { q: 'Tek adet baskı yapıyor musunuz?', a: 'Evet. Tek parça numuneden başlıyoruz; iş güvenliği levhası ve promosyon işlerinde yüzlerce ve binlerce adet seri üretim de yapıyoruz.' },
  { q: 'UV baskı dış mekânda dayanır mı?', a: 'UV ışınıyla sertleşen mürekkep dış mekânda yıllarca solmadan kalır; çizilmeye ve kimyasallara dirençlidir. Dış mekân levhalarında kompozit veya dekota gibi hava koşullarına uygun malzeme öneriyoruz.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: company.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'UV Baskı', item: `${company.siteUrl}/hizmetlerimiz/uv-baski/` },
    { '@type': 'ListItem', position: 3, name: 'Anadolu Yakası UV Baskı' },
  ],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Anadolu Yakası UV Baskı',
  serviceType: 'UV flatbed baskı',
  provider: { '@type': 'LocalBusiness', name: company.name, url: company.siteUrl },
  areaServed: ilceler.map(i => ({ '@type': 'AdministrativeArea', name: `${i.ad}, İstanbul Anadolu Yakası` })),
  url: `${company.siteUrl}/anadolu-yakasi-uv-baski/`,
};
---

<BaseLayout title={title} description={description} image={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <nav class="bg-koyu-50 border-b border-koyu-100 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-koyu-500">
        <li><a href="/" class="hover:text-eymen-600">Ana Sayfa</a></li>
        <li class="text-koyu-300">/</li>
        <li><a href="/hizmetlerimiz/uv-baski/" class="hover:text-eymen-600">UV Baskı</a></li>
        <li class="text-koyu-300">/</li>
        <li class="text-koyu-800 font-medium">Anadolu Yakası UV Baskı</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative bg-koyu-900 overflow-hidden pt-12 pb-12 md:pt-20 md:pb-20">
    <img src={heroImage} srcset={srcset(heroImage)} sizes="100vw" {...boyut(heroImage)} alt="" class="absolute inset-0 w-full h-full object-cover opacity-60" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-koyu-900/95 via-koyu-900/70 to-koyu-900/30"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-3">İSTANBUL ANADOLU YAKASI · KADIKÖY'DEN GEBZE'YE</p>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">Anadolu Yakası UV Baskı: Pendik'teki 4x2 m Flatbed Tesisimizden Kapınıza</h1>
        <p class="text-koyu-200 text-base md:text-lg leading-relaxed mb-6 md:mb-8">
          Cam, pleksi, ahşap, metal, kompozit ve dekota üzerine doğrudan UV baskıyı Pendik'teki SwissQprint flatbed makinemizde yapıyoruz.
          Beyaz altbaskı ve vernik, lazer ve CNC kesim aynı çatı altında. Anadolu Yakası'nın tamamında keşif ve montaj kendi ekibimizden.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3.5 rounded-xl font-bold transition-all">Malzeme ve ölçüyü WhatsApp'tan gönder</a>
          <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/60 text-white px-6 py-3.5 rounded-xl font-semibold transition-all">{contact.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Rakamlar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {[
        ['4x2 m', 'Flatbed baskı alanı, 10 cm kalınlığa kadar malzeme'],
        ['CMYK + Beyaz', 'Beyaz altbaskı, vernik ve spot lak'],
        ['1 adet', 'Minimum sipariş; seri üretimde birim fiyat düşer'],
        ['13 ilçe', 'Anadolu Yakası ve Gebze\'de keşif + montaj'],
      ].map(([v, l]) => (
        <div class="rounded-2xl border border-koyu-100 bg-koyu-50 p-5 text-center">
          <div class="text-2xl md:text-3xl font-extrabold text-eymen-600">{v}</div>
          <div class="text-xs md:text-sm text-koyu-600 mt-1 leading-snug">{l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Malzemeler -->
  <section class="py-12 md:py-20 bg-koyu-50" aria-labelledby="malzeme-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="malzeme-baslik" class="text-3xl md:text-4xl font-extrabold text-koyu-900">Hangi Yüzeylere UV Baskı Yapıyoruz?</h2>
        <p class="text-koyu-500 mt-4">Düz ve 10 cm'ye kadar kalın her sert yüzey. Malzemeyi biz temin edebiliriz, kendi malzemenizi de getirebilirsiniz.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {malzemeler.map(([m, d]) => (
          <div class="bg-white rounded-2xl border border-koyu-100 p-5">
            <h3 class="font-bold text-koyu-900">{m}</h3>
            <p class="text-sm text-koyu-500 mt-1 leading-relaxed">{d}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/hizmetlerimiz/uv-baski/" class="inline-flex items-center gap-2 text-eymen-700 font-semibold hover:text-eymen-800">Makine parkı, 12 fotoğraflık galeri ve fiyatı belirleyen etkenler: UV Baskı sayfası →</a>
      </div>
    </div>
  </section>

  <!-- İlçeler -->
  <section class="py-12 md:py-20 bg-white" aria-labelledby="ilce-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 id="ilce-baslik" class="text-3xl md:text-4xl font-extrabold text-koyu-900">Anadolu Yakası'nda İlçe İlçe UV Baskı</h2>
        <p class="text-koyu-600 mt-4 leading-relaxed">Baskı Pendik'teki tesisimizde yapılır. Aşağıdaki ilçelerde keşfe kendimiz geliyor, işi kendi ekibimizle monte ediyoruz; Avrupa Yakası ve diğer illere paketli kargo ile gönderiyoruz.</p>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {ilceler.map(i => (
          <li class="flex gap-3 rounded-xl border border-koyu-100 bg-koyu-50 p-4">
            <span class="w-2 h-2 mt-2 rounded-full bg-eymen-500 flex-shrink-0"></span>
            <div>
              <h3 class="font-bold text-koyu-900">{i.ad}</h3>
              <p class="text-sm text-koyu-500 leading-snug">{i.not}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Referans işler -->
  <section class="py-12 md:py-20 bg-koyu-900" aria-labelledby="is-baslik">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-3">SAHADAN</p>
        <h2 id="is-baslik" class="text-3xl md:text-4xl font-extrabold text-white">UV Baskı Yaptığımız İşler</h2>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {isler.map(r => (
          <li class="rounded-2xl bg-koyu-800 border border-white/10 p-5">
            <h3 class="font-bold text-white"><a href={r.href} class="hover:text-eymen-300">{r.ad}</a></h3>
            <p class="text-sm text-koyu-300 mt-2 leading-relaxed">{r.isler}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 md:py-24 bg-koyu-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900 text-center mb-12">Anadolu Yakası UV Baskı Hakkında Sık Sorulanlar</h2>
      <div class="space-y-4">
        {faq.map(f => (
          <details class="group bg-white rounded-xl border border-koyu-100 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-koyu-900 hover:text-eymen-600">
              {f.q}
              <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-koyu-500 leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-eymen-500 to-eymen-700 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Malzeme, Ölçü ve Adedi Yazın; Aynı Gün Fiyat Verelim</h2>
      <p class="text-eymen-100 text-lg mb-8 max-w-2xl mx-auto">Baskıya hazır dosyanız varsa ekleyin. Anadolu Yakası'nda ücretsiz keşif, Pendik tesisimizde numune görme imkânı.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-white text-eymen-600 hover:bg-koyu-50 px-8 py-4 rounded-xl font-bold transition-all">WhatsApp ile Yaz</a>
        <a href="/teklif-al/" class="inline-flex items-center justify-center gap-2 border-2 border-white/40 hover:border-white text-white px-8 py-4 rounded-xl font-semibold transition-all">Teklif Formu</a>
      </div>
    </div>
  </section>
</BaseLayout>
