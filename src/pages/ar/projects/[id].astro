---
import ProjeDetay from '../../../components/ProjeDetay.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const ceviriler = await getCollection('projelerAr');
  const trProjeler = await getCollection('projeler');
  return ceviriler.map(ceviri => ({
    params: { id: ceviri.id },
    props: { ceviri, tr: trProjeler.find(p => p.id === ceviri.id)! },
  }));
}

const { ceviri, tr } = Astro.props;
---
<ProjeDetay lang="ar" ceviri={ceviri} tr={tr} />
