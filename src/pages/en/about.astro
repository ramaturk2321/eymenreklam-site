---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { srcset, boyut, SIZES } from '../../lib/gorsel';
import { company, contact } from '../../lib/site-data';
import { oneCikanMarkalar, tumReferanslar } from '../../lib/referanslar';
import { yol } from '../../i18n';
---

<BaseLayout
  title="About Us — Signage Manufacturer in Istanbul"
  description={`Eymen Reklam — manufacturing signage and large-format printing in Pendik, Istanbul since 2000. A 2,500 m² facility and ${company.experience}+ years of production experience.`}
  lang="en"
  sayfa="hakkimizda"
>

  <!-- Hero -->
  <section class="bg-koyu-900 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-3">EYMEN REKLAM</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">About Us</h1>
      <p class="text-koyu-400 text-lg max-w-2xl mx-auto">
        Manufacturing in Pendik, Istanbul since 2000 — signage, UV printing and large-format digital printing, made in our own facility.
      </p>
    </div>
  </section>

  <!-- Hikaye -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="relative">
          <img
            src="/images/yenifabrika-opt.webp"
            srcset={srcset('/images/yenifabrika-opt.webp')}
            sizes={SIZES.yariGenislik}
            {...boyut('/images/yenifabrika-opt.webp')}
            alt="Eymen Reklam production facility in Pendik, Istanbul"
            class="rounded-2xl w-full h-auto shadow-xl"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div>
          <div class="space-y-5 text-koyu-600 leading-relaxed">
            <p>
              <strong class="text-koyu-900">Eymen Reklam</strong> (also known in the trade as
              <strong class="text-koyu-900">Eymen Ajans</strong>) is one of Turkey's established signage,
              advertising and printing manufacturers. What matters most to us is simpler than that: on every
              project we sit at the same table as the client, define the need together and shape the solution together.
            </p>
            <p>
              In our production facility we make vacuum-formed signs, mirror chrome signs, channel letters,
              pylon signs, façade wrapping, vehicle wrapping, posters, fabric and banner printing. We are
              involved at every step, from the first site survey to the final installation.
            </p>
            <p class="border-l-4 border-eymen-500 pl-5 italic text-koyu-700">
              "Good materials, serious production capacity and an experienced team — that is how we make a brand visible."
            </p>
            <p>
              For clients based outside Turkey, or head offices working with a local branch, we report and
              correspond in English throughout the project, and we can arrange export shipment of finished work.
            </p>
          </div>

          <a href="/eymen-reklam-sunumu.pdf" target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-8 text-eymen-600 font-semibold hover:text-eymen-700 transition-colors">
            View the company profile (PDF)
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Rakamlar -->
  <section class="bg-koyu-50 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-extrabold text-eymen-600">{company.experience}+</div>
          <div class="text-sm text-koyu-600 mt-2 font-medium">Years of Experience</div>
        </div>
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-extrabold text-eymen-600">2,500 m²</div>
          <div class="text-sm text-koyu-600 mt-2 font-medium">Production Facility</div>
        </div>
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-extrabold text-eymen-600">10,000+</div>
          <div class="text-sm text-koyu-600 mt-2 font-medium">Completed Projects</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Değerler -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold text-koyu-900 text-center mb-12">Why Work With Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-8 bg-white rounded-2xl border border-koyu-100">
          <span class="text-4xl block mb-4">🏭</span>
          <h3 class="text-lg font-bold text-koyu-900 mb-3">Production Capacity</h3>
          <p class="text-sm text-koyu-500 leading-relaxed">A large facility and a modern machine park mean high-volume orders are delivered on time and to specification.</p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl border border-koyu-100">
          <span class="text-4xl block mb-4">📏</span>
          <h3 class="text-lg font-bold text-koyu-900 mb-3">Sector Expertise</h3>
          <p class="text-sm text-koyu-500 leading-relaxed">Twenty-five years in signage, advertising and printing — knowledge that goes into every project we take on.</p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl border border-koyu-100">
          <span class="text-4xl block mb-4">🤝</span>
          <h3 class="text-lg font-bold text-koyu-900 mb-3">One Supplier, Whole Scope</h3>
          <p class="text-sm text-koyu-500 leading-relaxed">From sign manufacturing to digital printing, vehicle wrapping and full retail fit-outs — one contract covers the lot.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Referanslar -->
  <section class="py-16 md:py-24 bg-white border-y border-koyu-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-eymen-700 text-sm font-semibold tracking-wider mb-3">OUR CLIENTS</p>
        <h2 class="text-3xl font-extrabold text-koyu-900">Brands we work with</h2>
        <p class="text-koyu-500 text-lg max-w-2xl mx-auto mt-4">
          From Hakmar, a chain of more than 800 stores, to single-site restaurants — we have produced signage,
          UV printing, vinyl and retail branding for {tumReferanslar.length} corporate brands.
        </p>
      </div>
      <ul class="flex flex-wrap justify-center gap-2.5">
        {oneCikanMarkalar.map(r => (
          <li>
            <span class="inline-block px-4 py-2 rounded-full bg-koyu-50 border border-koyu-200 text-sm font-semibold text-koyu-800">{r.ad}</span>
          </li>
        ))}
      </ul>
      <div class="text-center mt-8">
        <a href={yol('en', 'referanslar')} class="inline-flex items-center gap-2 text-eymen-700 font-semibold hover:text-eymen-800">See all our clients →</a>
      </div>
    </div>
  </section>

  <!-- Belgeler -->
  <section class="py-16 md:py-24 bg-koyu-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-eymen-700 text-sm font-semibold tracking-wider mb-3">QUALITY &amp; SAFETY</p>
        <h2 class="text-3xl font-extrabold text-koyu-900">Certification</h2>
        <p class="text-koyu-500 max-w-2xl mx-auto mt-4">
          Our company holds the legal documentation and certification required for its work, including occupational health and safety.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div>
          <div class="rounded-xl overflow-hidden border border-koyu-200 bg-white group">
            <img src="/images/belgeler/isg-yuksekte-calisma-1.webp" srcset={srcset('/images/belgeler/isg-yuksekte-calisma-1.webp')} sizes="(min-width: 1280px) 230px, (min-width: 768px) 20vw, (min-width: 640px) 33vw, 50vw" alt="Working at height training certificate" width="895" height="1274" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </div>
          <p class="text-xs text-koyu-500 text-center mt-2 font-medium">Working at Height Training</p>
        </div>
        <div>
          <div class="rounded-xl overflow-hidden border border-koyu-200 bg-white group">
            <img src="/images/belgeler/isg-temel-egitim.webp" srcset={srcset('/images/belgeler/isg-temel-egitim.webp')} sizes="(min-width: 1280px) 230px, (min-width: 768px) 20vw, (min-width: 640px) 33vw, 50vw" alt="Occupational health and safety basic training certificate" width="895" height="1275" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </div>
          <p class="text-xs text-koyu-500 text-center mt-2 font-medium">OH&amp;S Basic Training</p>
        </div>
        <div>
          <div class="rounded-xl overflow-hidden border border-koyu-200 bg-white group">
            <img src="/images/belgeler/isg-katilim-tutanagi.webp" srcset={srcset('/images/belgeler/isg-katilim-tutanagi.webp')} sizes="(min-width: 1280px) 230px, (min-width: 768px) 20vw, (min-width: 640px) 33vw, 50vw" alt="Training attendance record" width="874" height="1230" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </div>
          <p class="text-xs text-koyu-500 text-center mt-2 font-medium">Attendance Record</p>
        </div>
        <div>
          <div class="rounded-xl overflow-hidden border border-koyu-200 bg-white group">
            <img src="/images/belgeler/isg-yuksekte-calisma-2.webp" srcset={srcset('/images/belgeler/isg-yuksekte-calisma-2.webp')} sizes="(min-width: 1280px) 230px, (min-width: 768px) 20vw, (min-width: 640px) 33vw, 50vw" alt="Working at height training certificate" width="834" height="1207" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </div>
          <p class="text-xs text-koyu-500 text-center mt-2 font-medium">Working at Height Training</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-eymen-500 to-eymen-700 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Let's talk about your project</h2>
      <p class="text-eymen-100 text-lg mb-8 max-w-2xl mx-auto">
        Get in touch for a free survey and quotation — we stay with the project from the first conversation to installation.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={yol('en', 'iletisim')} class="inline-flex items-center justify-center gap-2 bg-white text-eymen-600 hover:bg-koyu-50 px-8 py-4 rounded-xl text-base font-bold transition-all">
          Contact Us
        </a>
        <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/60 text-white px-8 py-4 rounded-xl text-base font-semibold transition-all">
          +90 216 379 07 08
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
