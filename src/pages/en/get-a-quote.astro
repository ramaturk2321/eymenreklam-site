---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company, contact, hours } from '../../lib/site-data';
import { yol } from '../../i18n';

const hizmetler = [
  'Channel Letters', 'Pylon / Totem Signs', 'Roof Signs', 'Façade Signage',
  'UV Printing', 'Digital Printing', 'Vehicle Wrapping', 'Façade Wrapping',
  'Banner Printing', 'Poster Printing', 'Window Film', 'Lightbox Panels',
  'Retail Concept', 'Safety Signage', 'Exhibition Stand', 'Other'
];
---

<BaseLayout
  title="Request a Quote — Signage and Printing in Istanbul"
  description="Request a free survey and a detailed quotation for signage, UV printing, vehicle wrapping and every other advertising production need in Istanbul."
  lang="en"
  sayfa="teklif"
>

  <!-- Hero -->
  <section class="bg-koyu-900 pt-32 pb-12 md:pt-40 md:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-3">CORPORATE ENQUIRIES</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Request a Quote</h1>
      <p class="text-koyu-400 text-lg max-w-2xl mx-auto">
        Send us the details of your project and we will come back within 24 hours with a priced quotation and a 3D preview.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- Form -->
        <div class="lg:col-span-2">
          <form class="space-y-6" id="teklif-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="6eef2241-f453-4dd5-8881-0566fadae644" />
            <input type="hidden" name="subject" value="Eymen Reklam — Corporate Quote Request (EN)" />
            <input type="hidden" name="from_name" value="Eymen Reklam Website (EN)" />
            <input type="hidden" name="site_language" value="English" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <div id="teklif-success" role="status" aria-live="polite" tabindex="-1" class="hidden outline-none bg-green-50 border border-green-200 rounded-xl p-6 text-center">
              <svg class="w-12 h-12 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <p class="text-lg font-semibold text-green-800">Your request has been sent.</p>
              <p class="text-sm text-green-600 mt-1">Our team will be in touch shortly.</p>
            </div>
            <div id="teklif-error" role="alert" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-center">
              <p class="text-sm font-medium text-red-700">Something went wrong. Please try again or call us.</p>
            </div>

            <!-- Company -->
            <div>
              <h2 class="text-lg font-bold text-koyu-900 mb-4 pb-2 border-b border-koyu-100">Company Details</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="tk-firma" class="block text-sm font-medium text-koyu-700 mb-1">Company Name *</label>
                  <input id="tk-firma" type="text" name="company" required autocomplete="organization" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="ABC Retail Ltd." />
                </div>
                <div>
                  <label for="tk-sektor" class="block text-sm font-medium text-koyu-700 mb-1">Sector</label>
                  <select id="tk-sektor" name="sector" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                    <option value="">Please select</option>
                    <option>Retail &amp; Shopping Centres</option>
                    <option>Food &amp; Beverage</option>
                    <option>Healthcare</option>
                    <option>Education &amp; Public Sector</option>
                    <option>Industry &amp; Manufacturing</option>
                    <option>Automotive &amp; Logistics</option>
                    <option>Hotels &amp; Hospitality</option>
                    <option>Construction &amp; Real Estate</option>
                    <option>Other</option>
                  </select>
                </div>
                <div>
                  <label for="tk-ulke" class="block text-sm font-medium text-koyu-700 mb-1">Country</label>
                  <input id="tk-ulke" type="text" name="country" autocomplete="country-name" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Türkiye" />
                </div>
                <div>
                  <label for="tk-teslim" class="block text-sm font-medium text-koyu-700 mb-1">Delivery</label>
                  <select id="tk-teslim" name="delivery" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                    <option value="">Please select</option>
                    <option>Installation by your team in Istanbul</option>
                    <option>Installation elsewhere in Turkey</option>
                    <option>Shipped to us — we install</option>
                    <option>Export shipment</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Contact -->
            <div>
              <h2 class="text-lg font-bold text-koyu-900 mb-4 pb-2 border-b border-koyu-100">Contact Details</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="tk-ad_soyad" class="block text-sm font-medium text-koyu-700 mb-1">Full Name *</label>
                  <input id="tk-ad_soyad" type="text" name="name" required autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Jane Doe" />
                </div>
                <div>
                  <label for="tk-unvan" class="block text-sm font-medium text-koyu-700 mb-1">Job Title</label>
                  <input id="tk-unvan" type="text" name="title" autocomplete="organization-title" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Procurement Manager" />
                </div>
                <div>
                  <label for="tk-telefon" class="block text-sm font-medium text-koyu-700 mb-1">Phone *</label>
                  <input id="tk-telefon" type="tel" name="phone" required autocomplete="tel" inputmode="tel" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="+90 5XX XXX XX XX" />
                </div>
                <div>
                  <label for="tk-eposta" class="block text-sm font-medium text-koyu-700 mb-1">Email *</label>
                  <input id="tk-eposta" type="email" name="email" required autocomplete="email" inputmode="email" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="name@company.com" />
                </div>
              </div>
            </div>

            <!-- Project -->
            <div>
              <h2 class="text-lg font-bold text-koyu-900 mb-4 pb-2 border-b border-koyu-100">Project Details</h2>
              <div class="space-y-4">
                <div>
                  <p id="tk-hizmetler-baslik" class="block text-sm font-medium text-koyu-700 mb-2">Which services do you need? *</p>
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-2" role="group" aria-labelledby="tk-hizmetler-baslik">
                    {hizmetler.map(h => (
                      <label class="flex items-center gap-2 px-3 py-2 rounded-lg border border-koyu-200 hover:border-eymen-300 cursor-pointer transition-colors text-sm">
                        <input type="checkbox" name="services" value={h} class="rounded border-koyu-300 text-eymen-500 focus:ring-eymen-500" />
                        <span class="text-koyu-600">{h}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="tk-lokasyon" class="block text-sm font-medium text-koyu-700 mb-1">Project Location</label>
                    <input id="tk-lokasyon" type="text" name="location" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Istanbul / Pendik" />
                  </div>
                  <div>
                    <label for="tk-termin" class="block text-sm font-medium text-koyu-700 mb-1">Timeline</label>
                    <select id="tk-termin" name="timeline" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                      <option value="">Please select</option>
                      <option>Urgent (within a week)</option>
                      <option>Short term (2–3 weeks)</option>
                      <option>Normal (about a month)</option>
                      <option>Still planning</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label for="tk-aciklama" class="block text-sm font-medium text-koyu-700 mb-1">Project Description</label>
                  <textarea id="tk-aciklama" rows="4" name="details" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm resize-none" placeholder="Dimensions, quantity, materials, number of locations, and anything else we should know."></textarea>
                </div>
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" id="teklif-submit-btn" class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-eymen-500 hover:bg-eymen-600 text-white px-10 py-4 rounded-xl text-base font-bold transition-all hover:shadow-lg hover:shadow-eymen-500/25">
                Send Request
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </button>
              <p class="text-xs text-koyu-500 mt-3">
                Your details are used only to prepare your quote and are never shared with third parties.
                <a href={yol('en', 'gizlilik')} class="text-koyu-500 underline decoration-koyu-300 hover:text-eymen-600">Details</a>
              </p>
            </div>
          </form>

          <script>
            import { formuKoru } from '../../lib/form-guard';

            const teklifForm = document.getElementById('teklif-form') as HTMLFormElement;
            const teklifBtn = document.getElementById('teklif-submit-btn') as HTMLButtonElement;
            const teklifSuccess = document.getElementById('teklif-success');
            const teklifError = document.getElementById('teklif-error');

            const guard = formuKoru(teklifForm);

            function btnYazisi(metin: string) {
              if (teklifBtn.childNodes[0]) teklifBtn.childNodes[0].textContent = metin;
            }

            teklifForm.addEventListener('submit', async (e) => {
              e.preventDefault();
              teklifBtn.disabled = true;
              btnYazisi('Sending... ');
              teklifSuccess?.classList.add('hidden');
              teklifError?.classList.add('hidden');

              const kontrol = guard.degerlendir();

              if (kontrol.engelle) {
                teklifForm.reset();
                teklifSuccess?.classList.remove('hidden');
                teklifSuccess?.focus();
                teklifBtn.disabled = false;
                btnYazisi('Send Request ');
                return;
              }

              try {
                const res = await fetch('https://api.web3forms.com/submit', {
                  method: 'POST',
                  body: guard.veriHazirla(kontrol)
                });
                const data = await res.json();
                if (data.success) {
                  if (window.trackEvent) window.trackEvent('quote_submit', { form: 'teklif-al', lang: 'en' });
                  teklifForm.reset();
                  teklifSuccess?.classList.remove('hidden');
                  teklifSuccess?.focus();
                  teklifSuccess?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                  teklifError?.classList.remove('hidden');
                }
              } catch (err) {
                teklifError?.classList.remove('hidden');
              }
              teklifBtn.disabled = false;
              btnYazisi('Send Request ');
            });
          </script>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-koyu-50 rounded-2xl p-6 border border-koyu-100">
            <h2 class="font-bold text-koyu-900 mb-4">What You Get Back</h2>
            <div class="space-y-3 text-sm text-koyu-600">
              <div class="flex items-start gap-3"><span class="text-eymen-600 mt-0.5">✓</span><span>A line-by-line cost breakdown, not a single lump sum</span></div>
              <div class="flex items-start gap-3"><span class="text-eymen-600 mt-0.5">✓</span><span>A 3D preview so you see the work before it is built</span></div>
              <div class="flex items-start gap-3"><span class="text-eymen-600 mt-0.5">✓</span><span>A formal proforma invoice and quotation letter</span></div>
              <div class="flex items-start gap-3"><span class="text-eymen-600 mt-0.5">✓</span><span>Prices stated clearly with and without VAT</span></div>
              <div class="flex items-start gap-3"><span class="text-eymen-600 mt-0.5">✓</span><span>A reply by email within 24 hours</span></div>
            </div>
          </div>

          <div class="bg-eymen-500 rounded-2xl p-6 text-white">
            <h2 class="font-bold mb-4">Call Us</h2>
            <div class="space-y-3 text-sm">
              <a href={contact.phoneHref} class="flex items-center gap-3 hover:text-eymen-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                +90 216 379 07 08
              </a>
              <a href={contact.mobileHref} class="flex items-center gap-3 hover:text-eymen-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                +90 545 549 11 62
              </a>
              <a href={contact.emailHref} class="flex items-center gap-3 hover:text-eymen-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {contact.email}
              </a>
            </div>
          </div>

          <div class="bg-koyu-50 rounded-2xl p-6 border border-koyu-100">
            <h2 class="font-bold text-koyu-900 mb-3">Facility &amp; Showroom</h2>
            <p class="text-sm text-koyu-600 leading-relaxed">
              Eymen Reklam production facility<br />
              Pendik, Istanbul<br />
              2,500 m² of covered production space
            </p>
            <p class="text-xs text-koyu-500 mt-3">Monday – Friday: {hours.open} – {hours.close} (GMT+3)</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="bg-koyu-900 rounded-xl p-4 text-center">
              <div class="text-2xl font-extrabold text-eymen-500">{company.experience}+</div>
              <div class="text-xs text-koyu-400 mt-1">Years</div>
            </div>
            <div class="bg-koyu-900 rounded-xl p-4 text-center">
              <div class="text-2xl font-extrabold text-eymen-500">10K+</div>
              <div class="text-xs text-koyu-400 mt-1">Projects</div>
            </div>
            <div class="bg-koyu-900 rounded-xl p-4 text-center">
              <div class="text-2xl font-extrabold text-eymen-500">500+</div>
              <div class="text-xs text-koyu-400 mt-1">Clients</div>
            </div>
            <div class="bg-koyu-900 rounded-xl p-4 text-center">
              <div class="text-2xl font-extrabold text-eymen-500">2.5K</div>
              <div class="text-xs text-koyu-400 mt-1">m² Facility</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
