---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { srcset, SIZES } from '../../../lib/gorsel';
import { getCollection } from 'astro:content';
import { company, contact } from '../../../lib/site-data';
import { yol, projeYolu } from '../../../i18n';
import { kategoriAdi } from '../../../lib/kategoriler';

const ceviriler = await getCollection('projelerEn');
const trProjeler = new Map((await getCollection('projeler')).map(p => [p.id, p]));

const projeler = ceviriler
  .map(c => {
    const tr = trProjeler.get(c.id);
    if (!tr) return null;
    return {
      id: c.id,
      title: c.data.title,
      description: c.data.description,
      image: tr.data.image,
      kategoriler: tr.data.categories.map(k => kategoriAdi(k, 'en')),
      date: tr.data.date,
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null)
  .sort((a, b) => b.date.localeCompare(a.date));

// Filtre sekmeleri — projelerde geçen kategorilerden türetilir.
const kategoriler = [...new Set(projeler.flatMap(p => p.kategoriler))].sort();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${company.siteUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${company.siteUrl}/en/projects/` },
  ],
};
---

<BaseLayout
  title="Our Projects — Signage and Printing in Istanbul"
  description="Selected projects: shopping centre signage, retail fit-outs, exhibition stands, façade wrapping, fleet wrapping and UV printing, produced and installed by Eymen Reklam in Istanbul."
  lang="en"
  sayfa="projeler"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-koyu-900 pt-32 pb-16 md:pt-40 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-eymen-400 text-sm font-semibold tracking-wider mb-3">SELECTED WORK</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Our Projects</h1>
      <p class="text-koyu-400 text-lg max-w-2xl mx-auto">
        Signage, retail fit-outs, exhibition stands, façade and fleet wrapping — produced in our own facility
        in Istanbul and installed by our own team.
      </p>
    </div>
  </section>

  <!-- Filtre + kartlar -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex flex-wrap justify-center gap-2 mb-10">
        <button
          class="proje-filtre px-4 py-2 rounded-full text-sm font-semibold border transition-colors bg-eymen-500 text-white border-eymen-500"
          data-kategori="all"
          aria-pressed="true"
        >All</button>
        {kategoriler.map(k => (
          <button
            class="proje-filtre px-4 py-2 rounded-full text-sm font-semibold border transition-colors bg-white text-koyu-600 border-koyu-200 hover:border-eymen-400"
            data-kategori={k}
            aria-pressed="false"
          >{k}</button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="proje-grid">
        {projeler.map(p => (
          <a
            href={projeYolu('en', p.id)}
            class="proje-kart group bg-white rounded-2xl border border-koyu-100 overflow-hidden hover:shadow-xl hover:border-eymen-200 transition-all duration-300 hover:-translate-y-1"
            data-kategoriler={p.kategoriler.join('|')}
          >
            <div class="aspect-[4/3] overflow-hidden relative bg-koyu-200">
              <img src={p.image} srcset={srcset(p.image)} sizes={SIZES.kart3} alt={p.title} width="600" height="450" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                {p.kategoriler.map(k => (
                  <span class="px-3 py-1 bg-eymen-500 text-white text-xs font-semibold rounded-full">{k}</span>
                ))}
              </div>
            </div>
            <div class="p-5">
              <h2 class="font-bold text-koyu-900 mb-2 group-hover:text-eymen-600 transition-colors">{p.title}</h2>
              <p class="text-sm text-koyu-500 leading-relaxed">{p.description}</p>
            </div>
          </a>
        ))}
      </div>

      <p class="text-center text-sm text-koyu-500 mt-10 max-w-2xl mx-auto">
        These are a selection. We have completed more than 10,000 projects since 2000 — tell us what you need
        and we will send references from your own sector.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-eymen-500 to-eymen-700 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4">Request a Quote for Your Project</h2>
      <p class="text-eymen-100 mb-8">We survey the site, prepare a 3D preview and send a detailed quotation within 24 hours.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={yol('en', 'teklif')} class="inline-flex items-center justify-center gap-2 bg-white text-eymen-600 hover:bg-koyu-50 px-8 py-4 rounded-xl text-base font-bold transition-all">
          Quote Request Form
        </a>
        <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/60 text-white px-8 py-4 rounded-xl text-base font-semibold transition-all">
          +90 216 379 07 08
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const butonlar = document.querySelectorAll<HTMLButtonElement>('.proje-filtre');
  const kartlar = document.querySelectorAll<HTMLElement>('.proje-kart');

  butonlar.forEach(btn => {
    btn.addEventListener('click', () => {
      const secili = btn.dataset.kategori || 'all';

      butonlar.forEach(b => {
        const aktif = b === btn;
        b.setAttribute('aria-pressed', String(aktif));
        b.classList.toggle('bg-eymen-500', aktif);
        b.classList.toggle('text-white', aktif);
        b.classList.toggle('border-eymen-500', aktif);
        b.classList.toggle('bg-white', !aktif);
        b.classList.toggle('text-koyu-600', !aktif);
        b.classList.toggle('border-koyu-200', !aktif);
      });

      kartlar.forEach(kart => {
        const kategoriler = (kart.dataset.kategoriler || '').split('|');
        kart.style.display = secili === 'all' || kategoriler.includes(secili) ? '' : 'none';
      });
    });
  });
</script>
