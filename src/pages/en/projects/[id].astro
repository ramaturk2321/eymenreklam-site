---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { srcset, SIZES } from '../../../lib/gorsel';
import { getCollection, render } from 'astro:content';
import { whatsappIcon, socialLinks } from '../../../lib/site-data';
import { whatsappUrl, yol, projeYolu, sozluk } from '../../../i18n';
import { kategoriAdi } from '../../../lib/kategoriler';

export async function getStaticPaths() {
  const ceviriler = await getCollection('projelerEn');
  const trProjeler = await getCollection('projeler');
  return ceviriler.map(ceviri => ({
    params: { id: ceviri.id },
    // Görseller, kategoriler ve tarih Türkçe sürümden gelir — tek kaynak.
    props: { ceviri, tr: trProjeler.find(p => p.id === ceviri.id)! },
  }));
}

const { ceviri, tr } = Astro.props;
const { Content } = await render(ceviri);
const s = sozluk('en');

const images = tr.data.images?.length ? tr.data.images : [tr.data.image];
const srcsets = images.map((i) => srcset(i) ?? '');
const hasGallery = images.length > 1;

const digerleri = (await getCollection('projelerEn'))
  .filter(p => p.id !== ceviri.id)
  .slice(0, 3);
const trHaritasi = new Map((await getCollection('projeler')).map(p => [p.id, p]));

const waUrl = whatsappUrl('en', s.whatsapp.proje);
---

<BaseLayout
  title={ceviri.data.seoTitle ?? ceviri.data.title}
  description={ceviri.data.description}
  image={tr.data.image}
  lang="en"
  sayfa="projeler"
  slug={ceviri.id}
  tur="proje"
>

  <!-- Breadcrumb -->
  <nav class="bg-koyu-50 border-b border-koyu-100 py-3" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-koyu-500">
        <li><a href={yol('en', 'ana')} class="hover:text-eymen-600 transition-colors">Home</a></li>
        <li class="text-koyu-300">/</li>
        <li><a href={yol('en', 'projeler')} class="hover:text-eymen-600 transition-colors">Projects</a></li>
        <li class="text-koyu-300">/</li>
        <li class="text-koyu-800 font-medium truncate">{ceviri.data.title}</li>
      </ol>
    </div>
  </nav>

  <section class="py-8 md:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14">

        <!-- Galeri -->
        <div class="flex gap-3">
          {hasGallery && (
            <div class="hidden md:flex flex-col gap-2 shrink-0 max-h-[500px] overflow-y-auto" id="thumb-strip">
              {images.map((img, i) => (
                <button
                  class:list={[
                    'gallery-thumb w-16 h-16 lg:w-20 lg:h-20 rounded-lg overflow-hidden border-2 transition-all shrink-0',
                    i === 0 ? 'border-eymen-500 ring-1 ring-eymen-300' : 'border-koyu-200 hover:border-eymen-400'
                  ]}
                  data-index={i}
                >
                  <img src={img} srcset={srcset(img)} sizes={SIZES.kucukResim} alt={`${ceviri.data.title} ${i+1}`} width="80" height="80" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
          <div class="relative flex-1 rounded-2xl overflow-hidden bg-koyu-100 group h-[350px] md:h-[450px] lg:h-[500px]" id="gallery">
            <img id="main-image" src={images[0]} srcset={srcset(images[0])} sizes={SIZES.yariGenislik} alt={ceviri.data.title} width="800" height="500" fetchpriority="high" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            {hasGallery && (
              <>
                <button id="prev-btn" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-lg transition-all" aria-label="Previous">
                  <svg class="w-5 h-5 text-koyu-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button id="next-btn" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-lg transition-all" aria-label="Next">
                  <svg class="w-5 h-5 text-koyu-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-black/50 text-white text-xs font-semibold px-3 py-1 rounded-full">
                  <span id="counter">1</span> / {images.length}
                </div>
              </>
            )}
          </div>
        </div>

        <!-- Bilgiler -->
        <div>
          <div class="flex flex-wrap gap-2 mb-3">
            {tr.data.categories.map(cat => (
              <span class="inline-flex items-center gap-1.5 bg-eymen-50 text-eymen-600 text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                {kategoriAdi(cat, 'en')}
              </span>
            ))}
          </div>

          <h1 class="text-2xl md:text-3xl font-bold text-koyu-900 mb-3 leading-tight">{ceviri.data.title}</h1>
          <p class="text-koyu-600 leading-relaxed mb-6">{ceviri.data.description}</p>

          <div class="prose prose-sm max-w-none prose-headings:text-koyu-900 prose-headings:font-bold prose-headings:text-lg prose-p:text-koyu-600 prose-li:text-koyu-600 prose-strong:text-koyu-800 prose-ul:my-2 prose-p:my-2">
            <Content />
          </div>

          <div class="flex items-center gap-2 mt-8">
            <a href={waUrl} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 bg-[#25D366] hover:bg-[#1fb855] text-white px-5 py-2.5 rounded-lg text-sm font-bold transition-all hover:shadow-lg hover:shadow-[#25D366]/25">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={whatsappIcon}/></svg>
              Request a Quote
            </a>
            {socialLinks.map(s2 => (
              <a href={s2.url} target="_blank" rel="noopener noreferrer" data-hover-bg={s2.color} class="social-share-icon w-9 h-9 bg-koyu-100 rounded-lg flex items-center justify-center text-koyu-500 transition-all flex-shrink-0" aria-label={s2.name}>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s2.icon}/></svg>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Mobil küçük görseller -->
  {hasGallery && (
    <div class="md:hidden px-4 pb-6">
      <div class="grid grid-cols-6 gap-1.5">
        {images.slice(0, 6).map((img, i) => (
          <button
            class:list={[
              'gallery-thumb rounded-lg overflow-hidden border-2 transition-all',
              i === 0 ? 'border-eymen-500' : 'border-transparent hover:border-koyu-300'
            ]}
            data-index={i}
          >
            <img src={img} srcset={srcset(img)} sizes="16vw" alt={`${ceviri.data.title} ${i+1}`} width="100" height="100" class="w-full aspect-square object-cover" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Diğer projeler -->
  {digerleri.length > 0 && (
    <section class="bg-koyu-50 py-12 border-t border-koyu-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold text-koyu-900 mb-8 text-center">Other Projects</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {digerleri.map(p => {
            const trP = trHaritasi.get(p.id);
            if (!trP) return null;
            return (
              <a href={projeYolu('en', p.id)} class="group bg-white rounded-2xl border border-koyu-100 overflow-hidden hover:shadow-xl hover:border-eymen-200 transition-all duration-300 hover:-translate-y-1">
                <div class="aspect-[4/3] overflow-hidden relative">
                  <img src={trP.data.image} srcset={srcset(trP.data.image)} sizes={SIZES.kart3} alt={p.data.title} width="600" height="450" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
                  <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                    {trP.data.categories.map(cat => (
                      <span class="px-3 py-1 bg-eymen-500 text-white text-xs font-semibold rounded-full">{kategoriAdi(cat, 'en')}</span>
                    ))}
                  </div>
                </div>
                <div class="p-5">
                  <h3 class="font-bold text-koyu-900 mb-2 group-hover:text-eymen-600 transition-colors">{p.data.title}</h3>
                  <p class="text-sm text-koyu-500 leading-relaxed">{p.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script define:vars={{ images, srcsets }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('main-image');
    const counter = document.getElementById('counter');
    const thumbs = document.querySelectorAll('.gallery-thumb');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    if (!mainImg || images.length <= 1) return;
    let current = 0;

    function goTo(index) {
      current = (index + images.length) % images.length;
      mainImg.srcset = srcsets[current] || '';
      mainImg.src = images[current];
      if (counter) counter.textContent = current + 1;
      thumbs.forEach((t) => {
        const idx = Number(t.dataset.index);
        t.classList.toggle('border-eymen-500', idx === current);
        t.classList.toggle('ring-1', idx === current);
        t.classList.toggle('ring-eymen-300', idx === current);
        t.classList.toggle('border-koyu-200', idx !== current);
        t.classList.toggle('border-transparent', idx !== current);
      });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
    thumbs.forEach(t => t.addEventListener('click', () => goTo(Number(t.dataset.index))));
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>('.social-share-icon').forEach(el => {
    const color = el.dataset.hoverBg || '';
    el.addEventListener('mouseenter', () => { el.style.backgroundColor = color; el.style.color = 'white'; });
    el.addEventListener('mouseleave', () => { el.style.backgroundColor = ''; el.style.color = ''; });
  });
</script>
