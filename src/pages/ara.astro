---
// Site içi arama — üst menüdeki arama kutusu buraya gelir (/ara/?q=...).
// Ürün, proje, hizmet ve blog tek listede aranır. Dizin build'de sayfaya gömülür,
// eşleştirme tarayıcıda yapılır (sunucu yok). Yalnızca TR; noindex + sitemap dışı.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { srcset } from '../lib/gorsel';
import { hizmetYolu } from '../i18n';
import { getWhatsAppUrl, whatsappMessages } from '../lib/site-data';

// Markdown gövdesinden aranabilir düz metin — başlık/kalın işaretleri ve link hedefleri atılır.
const duzMetin = (md: string | undefined, sinir = 1500) =>
  (md ?? '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*_>`-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, sinir);

type Kayit = {
  tur: 'proje' | 'urun' | 'hizmet' | 'blog';
  baslik: string;
  ozet: string;
  href: string;
  img?: string;
  srcset?: string;
  etiket?: string;
  /** Başlık dışında aranan metin (kategori, gövde) */
  metin: string;
};

const projeler: Kayit[] = (await getCollection('projeler'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(p => ({
    tur: 'proje',
    baslik: p.data.title,
    ozet: p.data.description,
    href: `/projelerimiz/${p.id}/`,
    img: p.data.image,
    srcset: srcset(p.data.image),
    etiket: p.data.categories[0],
    metin: `${p.data.categories.join(' ')} ${p.data.description} ${duzMetin(p.body)}`,
  }));

const urunler: Kayit[] = (await getCollection('urunler')).map(u => ({
  tur: 'urun',
  baslik: u.data.title,
  ozet: u.data.shortDesc,
  href: `/urunlerimiz/${u.id}/`,
  img: u.data.mainImg,
  srcset: srcset(u.data.mainImg),
  etiket: u.data.category,
  metin: `${u.data.category} ${u.data.shortDesc}`,
}));

const hizmetler: Kayit[] = (await getCollection('hizmetler'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(h => ({
    tur: 'hizmet',
    baslik: h.data.title,
    ozet: h.data.listDesc,
    href: hizmetYolu('tr', h.id),
    img: h.data.listImage,
    srcset: srcset(h.data.listImage),
    metin: `${h.data.description} ${h.data.listDesc} ${h.data.listFeatures.join(' ')}`,
  }));

const bloglar: Kayit[] = (await getCollection('blog'))
  .filter(b => b.data.published)
  .map(b => ({
    tur: 'blog',
    baslik: b.data.title,
    ozet: b.data.excerpt,
    href: `/blog/${b.id}/`,
    img: b.data.image,
    srcset: srcset(b.data.image),
    etiket: b.data.category,
    metin: `${b.data.category} ${b.data.excerpt} ${duzMetin(b.body, 800)}`,
  }));

const dizin = [...projeler, ...urunler, ...hizmetler, ...bloglar];
---

<BaseLayout title="Site İçi Arama" description="Eymen Reklam sitesinde ürün, proje, hizmet ve blog yazısı arayın." noindex>

  <section class="bg-krem-100 border-b border-krem-200 py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold text-koyu-900 mb-6">Sitede Ara</h1>
      <form action="/ara/" method="get" role="search" class="relative">
        <label for="ara-input" class="sr-only">Ürün, proje veya hizmet ara</label>
        <input
          type="search"
          id="ara-input"
          name="q"
          placeholder="Örn. kutu harf, Isuzu, branda, fabrika"
          autocomplete="off"
          class="w-full ps-5 pe-14 py-4 text-base border-2 border-koyu-200 rounded-full bg-white focus:border-eymen-500 focus:outline-none transition-colors text-koyu-800 placeholder:text-koyu-400"
        />
        <button type="submit" class="absolute end-2 top-1/2 -translate-y-1/2 bg-eymen-500 hover:bg-eymen-600 text-white rounded-full p-3 transition-colors" aria-label="Ara">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </form>
      <p id="ara-ozet" class="text-koyu-600 mt-4 min-h-6" aria-live="polite"></p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" id="ara-sonuclar"></div>

    <div id="ara-bos" class="hidden max-w-2xl mx-auto px-4 text-center">
      <p class="text-koyu-600 mb-6">Aradığınızı bulamadıysanız bize yazın — listede olmayan işleri de yapıyoruz.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={getWhatsAppUrl(whatsappMessages.proje)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1fb855] text-white px-6 py-3 rounded-xl font-bold transition-all">WhatsApp ile Sorun</a>
        <a href="/teklif-al/" class="inline-flex items-center justify-center gap-2 bg-eymen-500 hover:bg-eymen-600 text-white px-6 py-3 rounded-xl font-bold transition-all">Kurumsal Teklif Al</a>
      </div>
    </div>
  </section>

  <script type="application/json" id="ara-dizin" set:html={JSON.stringify(dizin)} />
</BaseLayout>

<script>
  type Kayit = {
    tur: 'proje' | 'urun' | 'hizmet' | 'blog';
    baslik: string; ozet: string; href: string;
    img?: string; srcset?: string; etiket?: string; metin: string;
  };

  const BOLUMLER: { tur: Kayit['tur']; ad: string }[] = [
    { tur: 'proje', ad: 'Projeler' },
    { tur: 'urun', ad: 'Ürünler' },
    { tur: 'hizmet', ad: 'Hizmetler' },
    { tur: 'blog', ad: 'Blog Yazıları' },
  ];

  // "Isuzu" / "ısuzu" / "ISUZU", "çatı" / "cati" aynı sonucu versin.
  const TR_HARF: Record<string, string> = { ı: 'i', İ: 'i', ş: 's', ğ: 'g', ü: 'u', ö: 'o', ç: 'c', â: 'a', î: 'i', û: 'u' };
  const normal = (s: string) =>
    s.toLocaleLowerCase('tr-TR').replace(/[ıişğüöçâîû]/g, h => TR_HARF[h] ?? h);

  const kacis = (s: string) =>
    s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const dizin: (Kayit & { _b: string; _m: string })[] = JSON.parse(
    document.getElementById('ara-dizin')!.textContent || '[]',
  ).map((k: Kayit) => ({ ...k, _b: normal(k.baslik), _m: normal(`${k.ozet} ${k.metin}`) }));

  const input = document.getElementById('ara-input') as HTMLInputElement;
  const ozet = document.getElementById('ara-ozet')!;
  const sonuclar = document.getElementById('ara-sonuclar')!;
  const bos = document.getElementById('ara-bos')!;

  function kart(k: Kayit): string {
    const gorsel = k.img
      ? `<div class="aspect-[4/3] overflow-hidden bg-koyu-50">
           <img src="${kacis(k.img)}" ${k.srcset ? `srcset="${kacis(k.srcset)}"` : ''}
             sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
             alt="${kacis(k.baslik)}" loading="lazy" decoding="async"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
         </div>`
      : '';
    const etiket = k.etiket
      ? `<span class="inline-block text-xs font-semibold text-eymen-700 mb-1">${kacis(k.etiket)}</span>`
      : '';
    return `<a href="${kacis(k.href)}" class="group bg-white rounded-2xl border border-koyu-100 overflow-hidden hover:shadow-xl hover:border-eymen-200 transition-all duration-300">
      ${gorsel}
      <div class="p-4">
        ${etiket}
        <h3 class="font-bold text-koyu-900 group-hover:text-eymen-600 transition-colors leading-snug mb-1">${kacis(k.baslik)}</h3>
        <p class="text-sm text-koyu-500 leading-relaxed line-clamp-2">${kacis(k.ozet)}</p>
      </div>
    </a>`;
  }

  function ara(sorgu: string) {
    const terimler = normal(sorgu).split(/\s+/).filter(t => t.length > 1);
    if (!terimler.length) {
      ozet.textContent = 'Ürün, proje, hizmet veya blog yazısı arayın.';
      sonuclar.innerHTML = '';
      bos.classList.add('hidden');
      return;
    }

    // Her terim başlıkta ya da metinde geçmeli; başlıkta geçen üste çıkar.
    const bulunan = dizin
      .map((k, sira) => {
        let puan = 0;
        for (const t of terimler) {
          if (k._b.includes(t)) puan += 10;
          else if (k._m.includes(t)) puan += 1;
          else return null;
        }
        return { k, puan, sira };
      })
      .filter((x): x is { k: (typeof dizin)[number]; puan: number; sira: number } => x !== null)
      .sort((a, b) => b.puan - a.puan || a.sira - b.sira)
      .map(x => x.k);

    ozet.textContent = bulunan.length
      ? `"${sorgu}" için ${bulunan.length} sonuç`
      : `"${sorgu}" için sonuç bulunamadı.`;
    bos.classList.toggle('hidden', bulunan.length > 0);

    sonuclar.innerHTML = BOLUMLER.map(({ tur, ad }) => {
      const grup = bulunan.filter(k => k.tur === tur);
      if (!grup.length) return '';
      return `<div class="mb-12">
        <h2 class="text-xl font-bold text-koyu-900 mb-5">${ad} <span class="text-koyu-400 font-normal text-base">(${grup.length})</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">${grup.map(kart).join('')}</div>
      </div>`;
    }).join('');
  }

  const q = new URLSearchParams(location.search).get('q') ?? '';
  input.value = q;
  ara(q);

  // Sayfada yazarken sonuç anında güncellensin; adres çubuğu da paylaşılabilir kalsın.
  let zamanlayici: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(zamanlayici);
    zamanlayici = window.setTimeout(() => {
      const deger = input.value.trim();
      history.replaceState(null, '', deger ? `/ara/?q=${encodeURIComponent(deger)}` : '/ara/');
      ara(deger);
    }, 150);
  });
</script>
