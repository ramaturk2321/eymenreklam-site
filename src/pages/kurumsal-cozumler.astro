---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, contact } from '../lib/site-data';

// ─── Öne çıkan yetenekler ───
const yetenekler = [
  {
    baslik: 'Merkezî Talep & İş Yönetimi',
    aciklama: 'Şube ve merkezden gelen tüm talepler tek CRM ekranında toplanır — hiçbir iş kaybolmaz. Üretim, onay ve termin süreçleri kayıt altında ilerler; gönderi takip sistemiyle birebir entegre çalışır.',
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    baslik: 'Otomatik Insert & Afiş Şablonu',
    aciklama: 'Marka kalıbınıza tanımlı şablonlarla insert, afiş ve raf etiketleri dakikalar içinde hazırlanır. Kampanya değişse de düzen, renk ve kurumsal kimlik sabit kalır — her şubeye tutarlı görsel gider.',
    icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  },
  {
    baslik: 'Yapay Zekâ Destekli Brief',
    aciklama: 'Kampanya talebiniz sisteme düştüğü an yapay zekâ ilk brief taslağını çıkarır: hangi görsel, hangi ölçü, hangi şube, hangi termin. Tasarım ekibi sıfırdan başlamaz, saatler kazanır.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    baslik: 'Şubeye Özel Esnek Takip',
    aciklama: 'Farklı bölge, farklı yetki, farklı onay akışı — her zincir kendi düzeninde çalışır. Sistem sizin operasyonunuza uyum sağlar, siz sisteme değil. Yetki ve raporlama şube bazında ayarlanır.',
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  },
];

// ─── Süreç adımları ───
const adimlar = [
  { no: '01', baslik: 'Talep sisteme düşer', metin: 'Şube veya merkez, ihtiyacını CRM üzerinden iletir. Talep anında kayıt altına alınır, kaybolmaz.' },
  { no: '02', baslik: 'Yapay zekâ brief çıkarır', metin: 'Sistem ilk brief taslağını ve uygun insert/afiş şablonunu otomatik önerir. Ekip zaman kazanır.' },
  { no: '03', baslik: 'Üretim & sevkiyat', metin: 'Onaylanan iş 2.500m² tesisimizde üretilir; gönderi ve montaj takibi tek panelde ilerler.' },
  { no: '04', baslik: 'Şeffaf raporlama', metin: 'Hangi şube hangi işi aldı, ne zaman teslim edildi — tümü kayıtlı ve raporlanabilir.' },
];

// ─── Neden Eymen ───
const nedenler = [
  '25 yıllık imalat tecrübesini kendi geliştirdiğimiz yazılım altyapısıyla birleştiriyoruz',
  'Reklam ajansı + üretim tesisi + yazılım ekibi tek çatı altında — arada aracı yok',
  'Yüzlerce şubeli ulusal perakende ve market zincirleriyle çalışma deneyimi',
  'Tabeladan inserte, folyodan raf görseline kadar tüm mağaza reklamını tek elden yönetiyoruz',
  'Kampanya yoğunluğunda bile tutarlı kurumsal kimlik ve hızlı termin',
];

// ─── Form sektör seçenekleri ───
const sektorler = ['Perakende & Market Zinciri', 'AVM & Mağazacılık', 'Franchise & Bayi Ağı', 'Restoran & Kafe Zinciri', 'Otel & Turizm', 'Bankacılık & Finans', 'Diğer'];
---

<BaseLayout
  title="Kurumsal Çözümler — Zincir Mağazalar için Reklam & Yazılım Altyapısı"
  description="Çok şubeli markalar için Eymen Reklam: kendi geliştirdiğimiz CRM & gönderi takip modülü, otomatik insert şablonu ve yapay zekâ destekli brief üretimi ile mağaza reklam operasyonunuzu tek elden yönetin.">

  <!-- ========== HERO ========== -->
  <section class="relative bg-koyu-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/cephe-giydirme.webp" alt="" aria-hidden="true" class="w-full h-full object-cover opacity-20" width="1920" height="700" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-koyu-900 via-koyu-900/95 to-koyu-800"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-eymen-500/15 text-eymen-400 text-xs font-bold tracking-widest px-4 py-2 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-eymen-500 animate-pulse"></span>
          KURUMSAL & ZİNCİR MAĞAZA ÇÖZÜMLERİ
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Sadece baskı değil,<br/>
          <span class="text-eymen-500">reklam operasyonunuzun</span> altyapısı
        </h1>
        <p class="text-lg md:text-xl text-koyu-300 mb-10 max-w-2xl leading-relaxed">
          Yüzlerce şubeye aynı anda gönderim yapmak karmaşıktır. Biz bu işi kendi geliştirdiğimiz
          <strong class="text-white font-semibold">kargo & gönderi takip sistemiyle</strong> çözüyoruz:
          <strong class="text-white font-semibold">çoklu gönderim tek ekranda</strong>,
          her şubenin durumu <strong class="text-white font-semibold">anlık ve kolay takip</strong>.
          Otomatik insert şablonları ve yapay zekâ destekli brief üretimi ile tüm reklam operasyonunuz tek elden ilerler.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demo" class="inline-flex items-center justify-center gap-2 bg-eymen-500 hover:bg-eymen-600 text-white px-8 py-4 rounded-lg text-base font-bold transition-all hover:shadow-xl hover:shadow-eymen-500/30">
            Kurumsal Demo Talep Et
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/eymen-reklam-sunumu.pdf" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white text-white px-8 py-4 rounded-lg text-base font-semibold transition-all hover:bg-white/10">
            Kurumsal Sunumu İncele
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== KARGO & GÖNDERİ TAKİP (ÖNE ÇIKAN) ========== -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Sol: Anlatım -->
        <div>
          <span class="inline-flex items-center gap-2 bg-eymen-500/10 text-eymen-700 text-xs font-bold tracking-widest px-4 py-2 rounded-full mb-5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1"/></svg>
            KARGO & GÖNDERİ TAKİP SİSTEMİ
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900 leading-tight mb-5">
            Çoklu gönderim,<br/><span class="text-eymen-500">tek ekranda kolay takip</span>
          </h2>
          <p class="text-koyu-600 leading-relaxed mb-8">
            Yüzlerce şubeye giden işleri tek tek aramak, tabloları güncel tutmaya çalışmak zamanınızı yiyor.
            Kendi geliştirdiğimiz gönderi takip sistemiyle tüm sevkiyatlarınızı tek panelden yönetin:
            hangi şubeye ne gönderildi, kargoya verildi mi, teslim edildi mi — anında görün.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-10 h-10 bg-eymen-500/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-eymen-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-koyu-900">Çoklu gönderim tek ekranda</h3>
                <p class="text-sm text-koyu-600 mt-0.5">Onlarca, yüzlerce şubeye giden sevkiyatı tek listede oluşturun ve yönetin — her biri için ayrı takip derdi yok.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-10 h-10 bg-eymen-500/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-eymen-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-koyu-900">Anlık durum & kolay takip</h3>
                <p class="text-sm text-koyu-600 mt-0.5">Hazırlanıyor → kargoda → teslim edildi. Her gönderinin durumu renkli ve net; telefonla sormaya gerek kalmaz.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 w-10 h-10 bg-eymen-500/10 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-eymen-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-koyu-900">Şube bazlı kayıt & raporlama</h3>
                <p class="text-sm text-koyu-600 mt-0.5">Hangi şube hangi işi ne zaman aldı, tümü kayıtlı. İhtilaf yok, geçmiş her an raporlanabilir.</p>
              </div>
            </div>
          </div>
          <a href="#demo" class="inline-flex items-center gap-2 mt-8 bg-eymen-500 hover:bg-eymen-600 text-white px-7 py-3.5 rounded-lg font-bold transition-all hover:shadow-xl hover:shadow-eymen-500/30">
            Takip Sistemini Canlı Görün
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Sağ: Görsel panel maketi -->
        <div class="bg-koyu-900 rounded-3xl p-6 md:p-8 shadow-2xl shadow-koyu-900/20">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
              <span class="w-3 h-3 rounded-full bg-green-400"></span>
            </div>
            <span class="text-xs font-semibold text-koyu-400">Gönderi Takip Paneli</span>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between bg-koyu-800 rounded-xl px-4 py-3.5">
              <div>
                <div class="text-sm font-semibold text-white">Şube #124 — Pendik</div>
                <div class="text-xs text-koyu-400">İnsert · 4 sayfa · 500 adet</div>
              </div>
              <span class="text-xs font-bold text-green-400 bg-green-400/10 px-3 py-1.5 rounded-full whitespace-nowrap">Teslim edildi</span>
            </div>
            <div class="flex items-center justify-between bg-koyu-800 rounded-xl px-4 py-3.5">
              <div>
                <div class="text-sm font-semibold text-white">Şube #087 — Kartal</div>
                <div class="text-xs text-koyu-400">Raf afişi · A2 · 30 adet</div>
              </div>
              <span class="text-xs font-bold text-eymen-400 bg-eymen-400/10 px-3 py-1.5 rounded-full whitespace-nowrap">Kargoda</span>
            </div>
            <div class="flex items-center justify-between bg-koyu-800 rounded-xl px-4 py-3.5">
              <div>
                <div class="text-sm font-semibold text-white">Şube #203 — Tuzla</div>
                <div class="text-xs text-koyu-400">Vitrin folyo · 2 m²</div>
              </div>
              <span class="text-xs font-bold text-yellow-400 bg-yellow-400/10 px-3 py-1.5 rounded-full whitespace-nowrap">Hazırlanıyor</span>
            </div>
            <div class="flex items-center justify-between bg-koyu-800 rounded-xl px-4 py-3.5">
              <div>
                <div class="text-sm font-semibold text-white">Şube #056 — Maltepe</div>
                <div class="text-xs text-koyu-400">İnsert · 4 sayfa · 500 adet</div>
              </div>
              <span class="text-xs font-bold text-green-400 bg-green-400/10 px-3 py-1.5 rounded-full whitespace-nowrap">Teslim edildi</span>
            </div>
          </div>
          <div class="mt-6 pt-5 border-t border-koyu-700 flex items-center justify-between text-sm">
            <span class="text-koyu-400">Bu kampanyada toplam gönderim</span>
            <span class="font-extrabold text-white">248 şube</span>
          </div>
          <p class="text-[11px] text-koyu-500 mt-4 text-center">Örnek panel görünümü — gerçek sistem markanıza göre yapılandırılır.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== YETENEKLER ========== -->
  <section class="py-20 md:py-28 bg-koyu-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 justify-center mb-4">
          <div class="w-10 h-[2px] bg-eymen-500"></div>
          <span class="text-eymen-700 text-sm font-bold tracking-widest">GÜÇLÜ YÖNÜMÜZ</span>
          <div class="w-10 h-[2px] bg-eymen-500"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900">Yazılımla Güçlenen Reklam Üretimi</h2>
        <p class="text-koyu-500 mt-4">Rakiplerimizden farkımız: işi sadece basmıyoruz, uçtan uca dijital olarak yönetiyoruz.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {yetenekler.map(y => (
          <div class="group bg-white hover:bg-white border border-koyu-100 hover:border-eymen-200 rounded-2xl p-8 transition-all hover:shadow-xl hover:shadow-koyu-900/5">
            <div class="w-14 h-14 bg-eymen-500/10 group-hover:bg-eymen-500 rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
              <svg class="w-7 h-7 text-eymen-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={y.icon}/></svg>
            </div>
            <h3 class="text-xl font-bold text-koyu-900 mb-3">{y.baslik}</h3>
            <p class="text-koyu-600 leading-relaxed">{y.aciklama}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== SÜREÇ ========== -->
  <section class="py-20 md:py-28 bg-koyu-900 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 justify-center mb-4">
          <div class="w-10 h-[2px] bg-eymen-500"></div>
          <span class="text-eymen-400 text-sm font-bold tracking-widest">NASIL ÇALIŞIR</span>
          <div class="w-10 h-[2px] bg-eymen-500"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white">Talepten Teslimata Tek Akış</h2>
        <p class="text-koyu-400 mt-4">Karmaşık operasyon, dört net adıma indirgenir.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {adimlar.map(a => (
          <div class="relative bg-koyu-800/60 border border-koyu-700 rounded-2xl p-7">
            <div class="text-5xl font-extrabold text-eymen-500/30 mb-4">{a.no}</div>
            <h3 class="text-lg font-bold text-white mb-2">{a.baslik}</h3>
            <p class="text-sm text-koyu-400 leading-relaxed">{a.metin}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== NEDEN EYMEN ========== -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="w-10 h-[2px] bg-eymen-500"></div>
            <span class="text-eymen-700 text-sm font-bold tracking-widest">NEDEN EYMEN REKLAM</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900 mb-6 leading-tight">
            İmalat gücü + yazılım zekâsı<br/>tek çatı altında
          </h2>
          <p class="text-koyu-600 leading-relaxed mb-8">
            Çoğu tedarikçi ya sadece basar ya sadece tasarlar. Biz 25 yıllık üretim tesisimizi,
            kendi geliştirdiğimiz yazılım altyapısıyla birleştirerek zincir markaların tüm reklam
            operasyonunu tek noktadan yönetiyoruz.
          </p>
          <ul class="space-y-4">
            {nedenler.map(n => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-eymen-500 rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span class="text-koyu-700">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-koyu-900 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-eymen-500">{company.experience}+</div>
            <div class="text-sm text-koyu-400 mt-2">Yıllık İmalat Tecrübesi</div>
          </div>
          <div class="bg-eymen-500 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-white">2.500m²</div>
            <div class="text-sm text-white/80 mt-2">Üretim Tesisi</div>
          </div>
          <div class="bg-koyu-50 border border-koyu-100 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-koyu-900">Tek</div>
            <div class="text-sm text-koyu-500 mt-2">Panelden Tüm Şubeler</div>
          </div>
          <div class="bg-koyu-50 border border-koyu-100 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-koyu-900">AI</div>
            <div class="text-sm text-koyu-500 mt-2">Destekli Brief & Şablon</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ÖZEL YAZILIM & AI ÇÖZÜMLERİ ========== -->
  <section class="py-20 md:py-28 bg-koyu-900 relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/tabela-imalat.webp" alt="" aria-hidden="true" class="w-full h-full object-cover opacity-10" width="1600" height="600" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-br from-koyu-900 via-koyu-900/95 to-koyu-800"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14">
