          <p class="text-xs text-koyu-500">* Bilgileriniz gizli tutulur, yalnızca demo görüşmesi için kullanılır.</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const demoForm = document.getElementById('demo-form') as HTMLFormElement | null;
    const demoBtn = document.getElementById('demo-submit-btn') as HTMLButtonElement | null;
    const demoSuccess = document.getElementById('demo-success');
    const demoError = document.getElementById('demo-error');

    demoForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!demoBtn) return;
      demoBtn.disabled = true;
      demoBtn.querySelector('svg')?.classList.add('hidden');
      demoBtn.childNodes[0].textContent = 'Gönderiliyor... ';
      demoSuccess?.classList.add('hidden');
      demoError?.classList.add('hidden');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(demoForm),
        });
        const data = await res.json();
        if (data.success) {
          demoForm.querySelectorAll('input:not([type=hidden]), textarea, select').forEach(el => {
            const field = el as HTMLInputElement;
            if (field.type === 'checkbox') field.checked = false;
            else field.value = '';
          });
          demoSuccess?.classList.remove('hidden');
          demoSuccess?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          demoError?.classList.remove('hidden');
        }
      } catch (err) {
        demoError?.classList.remove('hidden');
      }
      demoBtn.disabled = false;
      demoBtn.querySelector('svg')?.classList.remove('hidden');
      demoBtn.childNodes[0].textContent = 'Kurumsal Demo Talep Et ';
    });
  </script>

