---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, contact } from '../lib/site-data';

// ─── Öne çıkan yetenekler ───
const yetenekler = [
  {
    baslik: 'CRM & Gönderi Takip Modülü',
    aciklama: 'Her şubenin işini tek panelden takip edin: talep, üretim, sevkiyat ve teslimat şeffaf biçimde kayıt altında. Şubeye özel, esnek takip kuralları tanımlanır — hangi mağaza hangi işi ne zaman aldı, anında görünür.',
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    baslik: 'Otomatik Insert & Afiş Şablonu',
    aciklama: 'Marka kalıbınıza tanımlı şablonlarla insert, afiş ve raf etiketleri dakikalar içinde hazırlanır. Kampanya değişse de düzen, renk ve kurumsal kimlik sabit kalır — her şubeye tutarlı görsel gider.',
    icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  },
  {
    baslik: 'Yapay Zekâ Destekli Brief',
    aciklama: 'Kampanya talebiniz sisteme düştüğü an yapay zekâ ilk brief taslağını çıkarır: hangi görsel, hangi ölçü, hangi şube, hangi termin. Tasarım ekibi sıfırdan başlamaz, saatler kazanır.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    baslik: 'Şubeye Özel Esnek Takip',
    aciklama: 'Farklı bölge, farklı yetki, farklı onay akışı — her zincir kendi düzeninde çalışır. Sistem sizin operasyonunuza uyum sağlar, siz sisteme değil. Yetki ve raporlama şube bazında ayarlanır.',
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  },
];

// ─── Süreç adımları ───
const adimlar = [
  { no: '01', baslik: 'Talep sisteme düşer', metin: 'Şube veya merkez, ihtiyacını CRM üzerinden iletir. Talep anında kayıt altına alınır, kaybolmaz.' },
  { no: '02', baslik: 'Yapay zekâ brief çıkarır', metin: 'Sistem ilk brief taslağını ve uygun insert/afiş şablonunu otomatik önerir. Ekip zaman kazanır.' },
  { no: '03', baslik: 'Üretim & sevkiyat', metin: 'Onaylanan iş 2.500m² tesisimizde üretilir; gönderi ve montaj takibi tek panelde ilerler.' },
  { no: '04', baslik: 'Şeffaf raporlama', metin: 'Hangi şube hangi işi aldı, ne zaman teslim edildi — tümü kayıtlı ve raporlanabilir.' },
];

// ─── Neden Eymen ───
const nedenler = [
  '25 yıllık imalat tecrübesini kendi geliştirdiğimiz yazılım altyapısıyla birleştiriyoruz',
  'Reklam ajansı + üretim tesisi + yazılım ekibi tek çatı altında — arada aracı yok',
  'Yüzlerce şubeli ulusal perakende ve market zincirleriyle çalışma deneyimi',
  'Tabeladan inserte, folyodan raf görseline kadar tüm mağaza reklamını tek elden yönetiyoruz',
  'Kampanya yoğunluğunda bile tutarlı kurumsal kimlik ve hızlı termin',
];

// ─── Form sektör seçenekleri ───
const sektorler = ['Perakende & Market Zinciri', 'AVM & Mağazacılık', 'Franchise & Bayi Ağı', 'Restoran & Kafe Zinciri', 'Otel & Turizm', 'Bankacılık & Finans', 'Diğer'];
---

<BaseLayout
  title="Kurumsal Çözümler — Zincir Mağazalar için Reklam & Yazılım Altyapısı"
  description="Çok şubeli markalar için Eymen Reklam: kendi geliştirdiğimiz CRM & gönderi takip modülü, otomatik insert şablonu ve yapay zekâ destekli brief üretimi ile mağaza reklam operasyonunuzu tek elden yönetin.">

  <!-- ========== HERO ========== -->
  <section class="relative bg-koyu-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/cephe-giydirme.webp" alt="" aria-hidden="true" class="w-full h-full object-cover opacity-20" width="1920" height="700" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-koyu-900 via-koyu-900/95 to-koyu-800"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-eymen-500/15 text-eymen-400 text-xs font-bold tracking-widest px-4 py-2 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-eymen-500 animate-pulse"></span>
          KURUMSAL & ZİNCİR MAĞAZA ÇÖZÜMLERİ
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Sadece baskı değil,<br/>
          <span class="text-eymen-500">reklam operasyonunuzun</span> altyapısı
        </h1>
        <p class="text-lg md:text-xl text-koyu-300 mb-10 max-w-2xl leading-relaxed">
          Çok şubeli markaların mağaza reklamını yönetmek karmaşıktır. Biz bu işi;
          kendi geliştirdiğimiz <strong class="text-white font-semibold">CRM & gönderi takip modülü</strong>,
          <strong class="text-white font-semibold">otomatik insert şablonları</strong> ve
          <strong class="text-white font-semibold">yapay zekâ destekli brief üretimi</strong> ile
          tek elden, şeffaf ve hızlı hale getiriyoruz.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demo" class="inline-flex items-center justify-center gap-2 bg-eymen-500 hover:bg-eymen-600 text-white px-8 py-4 rounded-lg text-base font-bold transition-all hover:shadow-xl hover:shadow-eymen-500/30">
            Kurumsal Demo Talep Et
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/eymen-reklam-sunumu.pdf" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white text-white px-8 py-4 rounded-lg text-base font-semibold transition-all hover:bg-white/10">
            Kurumsal Sunumu İncele
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== YETENEKLER ========== -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 justify-center mb-4">
          <div class="w-10 h-[2px] bg-eymen-500"></div>
          <span class="text-eymen-700 text-sm font-bold tracking-widest">GÜÇLÜ YÖNÜMÜZ</span>
          <div class="w-10 h-[2px] bg-eymen-500"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900">Yazılımla Güçlenen Reklam Üretimi</h2>
        <p class="text-koyu-500 mt-4">Rakiplerimizden farkımız: işi sadece basmıyoruz, uçtan uca dijital olarak yönetiyoruz.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {yetenekler.map(y => (
          <div class="group bg-koyu-50 hover:bg-white border border-koyu-100 hover:border-eymen-200 rounded-2xl p-8 transition-all hover:shadow-xl hover:shadow-koyu-900/5">
            <div class="w-14 h-14 bg-eymen-500/10 group-hover:bg-eymen-500 rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
              <svg class="w-7 h-7 text-eymen-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={y.icon}/></svg>
            </div>
            <h3 class="text-xl font-bold text-koyu-900 mb-3">{y.baslik}</h3>
            <p class="text-koyu-600 leading-relaxed">{y.aciklama}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== SÜREÇ ========== -->
  <section class="py-20 md:py-28 bg-koyu-900 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 justify-center mb-4">
          <div class="w-10 h-[2px] bg-eymen-500"></div>
          <span class="text-eymen-400 text-sm font-bold tracking-widest">NASIL ÇALIŞIR</span>
          <div class="w-10 h-[2px] bg-eymen-500"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white">Talepten Teslimata Tek Akış</h2>
        <p class="text-koyu-400 mt-4">Karmaşık operasyon, dört net adıma indirgenir.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {adimlar.map(a => (
          <div class="relative bg-koyu-800/60 border border-koyu-700 rounded-2xl p-7">
            <div class="text-5xl font-extrabold text-eymen-500/30 mb-4">{a.no}</div>
            <h3 class="text-lg font-bold text-white mb-2">{a.baslik}</h3>
            <p class="text-sm text-koyu-400 leading-relaxed">{a.metin}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== NEDEN EYMEN ========== -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="w-10 h-[2px] bg-eymen-500"></div>
            <span class="text-eymen-700 text-sm font-bold tracking-widest">NEDEN EYMEN REKLAM</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900 mb-6 leading-tight">
            İmalat gücü + yazılım zekâsı<br/>tek çatı altında
          </h2>
          <p class="text-koyu-600 leading-relaxed mb-8">
            Çoğu tedarikçi ya sadece basar ya sadece tasarlar. Biz 25 yıllık üretim tesisimizi,
            kendi geliştirdiğimiz yazılım altyapısıyla birleştirerek zincir markaların tüm reklam
            operasyonunu tek noktadan yönetiyoruz.
          </p>
          <ul class="space-y-4">
            {nedenler.map(n => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-eymen-500 rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span class="text-koyu-700">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-koyu-900 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-eymen-500">{company.experience}+</div>
            <div class="text-sm text-koyu-400 mt-2">Yıllık İmalat Tecrübesi</div>
          </div>
          <div class="bg-eymen-500 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-white">2.500m²</div>
            <div class="text-sm text-white/80 mt-2">Üretim Tesisi</div>
          </div>
          <div class="bg-koyu-50 border border-koyu-100 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-koyu-900">Tek</div>
            <div class="text-sm text-koyu-500 mt-2">Panelden Tüm Şubeler</div>
          </div>
          <div class="bg-koyu-50 border border-koyu-100 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-koyu-900">AI</div>
            <div class="text-sm text-koyu-500 mt-2">Destekli Brief & Şablon</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== DEMO FORM ========== -->
  <section id="demo" class="py-20 md:py-28 bg-koyu-50 scroll-mt-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 justify-center mb-4">
          <div class="w-10 h-[2px] bg-eymen-500"></div>
          <span class="text-eymen-700 text-sm font-bold tracking-widest">DEMO TALEP</span>
          <div class="w-10 h-[2px] bg-eymen-500"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-koyu-900">Sistemi Canlı Görün</h2>
        <p class="text-koyu-500 mt-4">CRM panelini, insert şablonlarını ve AI brief akışını markanıza özel bir görüşmede gösterelim. Formu bırakın, 24 saat içinde dönüş yapalım.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl shadow-koyu-900/5 border border-koyu-100 p-6 md:p-10">
        <form id="demo-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value="6eef2241-f453-4dd5-8881-0566fadae644" />
          <input type="hidden" name="subject" value="Eymen Reklam — Kurumsal Demo Talebi" />
          <input type="hidden" name="from_name" value="Eymen Reklam Website — Kurumsal Çözümler" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div id="demo-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
            <svg class="w-12 h-12 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <p class="text-lg font-semibold text-green-800">Demo talebiniz alındı!</p>
            <p class="text-sm text-green-600 mt-1">Kurumsal ekibimiz en kısa sürede sizinle iletişime geçecek.</p>
          </div>
          <div id="demo-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-center">
            <p class="text-sm font-medium text-red-700">Bir hata oluştu. Lütfen tekrar deneyin veya bizi arayın.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Firma Adı *</label>
              <input type="text" name="firma" required class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="ABC Perakende A.Ş." />
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Sektör</label>
              <select name="sektor" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                <option value="">Seçiniz</option>
                {sektorler.map(s => (<option>{s}</option>))}
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Ad Soyad *</label>
              <input type="text" name="ad_soyad" required class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Ahmet Yılmaz" />
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Unvan / Pozisyon</label>
              <input type="text" name="unvan" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="Pazarlama Müdürü" />
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">E-posta *</label>
              <input type="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="ahmet@firma.com" />
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Telefon *</label>
              <input type="tel" name="telefon" required class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm" placeholder="0532 XXX XX XX" />
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Yaklaşık Şube Sayısı</label>
              <select name="sube_sayisi" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                <option value="">Seçiniz</option>
                <option>1 – 10 şube</option>
                <option>10 – 50 şube</option>
                <option>50 – 200 şube</option>
                <option>200+ şube</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Öncelikli İhtiyaç</label>
              <select name="ihtiyac" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                <option value="">Seçiniz</option>
                <option>Gönderi / iş takip sistemi</option>
                <option>Otomatik insert & afiş üretimi</option>
                <option>AI destekli brief / tasarım hızı</option>
                <option>Tüm mağaza reklam operasyonu</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-koyu-700 mb-1">Kısa Not</label>
            <textarea rows="3" name="not" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm resize-none" placeholder="Mevcut operasyonunuz ve beklentiniz hakkında kısaca yazın..."></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-4">
            <button type="submit" id="demo-submit-btn" class="inline-flex items-center justify-center gap-2 bg-eymen-500 hover:bg-eymen-600 text-white px-10 py-4 rounded-xl text-base font-bold transition-all hover:shadow-lg hover:shadow-eymen-500/25">
              Kurumsal Demo Talep Et
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </button>
            <a href={contact.phoneHref} class="inline-flex items-center gap-2 text-koyu-600 hover:text-eymen-600 font-semibold text-sm transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Hemen arayın: {contact.phone}
            </a>
          </div>
          <p class="text-xs text-koyu-500">* Bilgileriniz gizli tutulur, yalnızca demo görüşmesi için kullanılır.</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const demoForm = document.getElementById('demo-form') as HTMLFormElement | null;
    const demoBtn = document.getElementById('demo-submit-btn') as HTMLButtonElement | null;
    const demoSuccess = document.getElementById('demo-success');
    const demoError = document.getElementById('demo-error');

    demoForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!demoBtn) return;
      demoBtn.disabled = true;
      demoBtn.querySelector('svg')?.classList.add('hidden');
      demoBtn.childNodes[0].textContent = 'Gönderiliyor... ';
      demoSuccess?.classList.add('hidden');
      demoError?.classList.add('hidden');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(demoForm),
        });
        const data = await res.json();
        if (data.success) {
          demoForm.querySelectorAll('input:not([type=hidden]), textarea, select').forEach(el => {
            const field = el as HTMLInputElement;
            if (field.type === 'checkbox') field.checked = false;
            else field.value = '';
          });
          demoSuccess?.classList.remove('hidden');
          demoSuccess?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          demoError?.classList.remove('hidden');
        }
      } catch (err) {
        demoError?.classList.remove('hidden');
      }
      demoBtn.disabled = false;
      demoBtn.querySelector('svg')?.classList.remove('hidden');
      demoBtn.childNodes[0].textContent = 'Kurumsal Demo Talep Et ';
    });
  </script>

</BaseLayout>
