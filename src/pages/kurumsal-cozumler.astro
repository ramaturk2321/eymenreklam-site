              <select name="sube_sayisi" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                <option value="">Seçiniz</option>
                <option>1 – 10 şube</option>
                <option>10 – 50 şube</option>
                <option>50 – 200 şube</option>
                <option>200+ şube</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-koyu-700 mb-1">Öncelikli İhtiyaç</label>
              <select name="ihtiyac" class="w-full px-4 py-3 rounded-xl border border-koyu-200 focus:border-eymen-500 focus:ring-2 focus:ring-eymen-500/20 outline-none transition-all text-sm">
                <option value="">Seçiniz</option>
                <option>Gönderi / iş takip sistemi</option>
                <option>Otomatik insert & afiş üretimi</option>
                <option>AI destekli brief / tasarım hızı</option>
