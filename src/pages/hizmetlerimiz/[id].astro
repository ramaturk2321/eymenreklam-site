---
import HizmetDetay from '../../components/HizmetDetay.astro';
import { getCollection } from 'astro:content';
import { hizmetReferanslari, type HizmetId } from '../../lib/referanslar';

export async function getStaticPaths() {
  const hizmetler = await getCollection('hizmetler');
  return hizmetler.map(hizmet => ({
    params: { id: hizmet.id },
    props: { hizmet },
  }));
}

const { hizmet } = Astro.props;
const d = hizmet.data;

// Hizmet sayfasında öne çıkan son kurumsal projeler — slug yanlışsa build kırılır.
const ONE_CIKAN_PROJELER: Partial<Record<HizmetId, string[]>> = {
  tabela: [
    'tatbak-gebze-magaza',
    'koop-market-magaza-tabela',
    'pawco-water-garden-avm',
    'beko-bereket-mobilya-totem',
    'civil-bursa',
    'isuzu-yonlendirme',
  ],
  'uv-baski': [
    'boldy-1453-maslak',
    'pawco-water-garden-avm',
    'kiler-gyo-referans-pendik',
    'etiler-2plan',
    'civil-bursa',
    'is-guvenligi-uv',
  ],
  'folyo-giydirme': [
    'puppet-pet-pendik',
    'yumtat-kamyon-giydirme',
    'arac-giydirme-uygulamalari',
  ],
};
const tumProjeler = await getCollection('projeler');
const projeler = (ONE_CIKAN_PROJELER[hizmet.id as HizmetId] ?? []).map(slug => {
  const p = tumProjeler.find(x => x.id === slug);
  if (!p) throw new Error(`hizmetlerimiz/${hizmet.id}: proje bulunamadı: ${slug}`);
  return { href: `/projelerimiz/${slug}/`, title: p.data.title, description: p.data.description, image: p.data.image };
});
---

<HizmetDetay
  slug={hizmet.id}
  title={d.title}
  seoTitle={d.seoTitle}
  description={d.description}
  heroDesc={d.heroDesc}
  heroImage={d.heroImage}
  heroTitle={d.heroTitle}
  gallery={d.gallery}
  galeriAciklama={d.galeriAciklama}
  projeler={projeler}
  fiyatFaktorleri={d.fiyatFaktorleri}
  bolge={d.bolge}
  ogImage={d.heroImage ?? d.listImage}
  facility={d.facility}
  features={d.features}
  products={d.products}
  process={d.process}
  sectors={d.sectors}
  faq={d.faq}
  referanslar={hizmetReferanslari(hizmet.id as HizmetId)}
/>
